# Load ./.env (gitignored) so env-guarded tests pick up local config (e.g. IDPD_*).
set dotenv-load := true

# Every recipe builds, vets and tests as the images do (go/docs/design.md): a module or
# dependency that needs cgo fails `just check` here instead of in the Docker build.
export CGO_ENABLED := "0"

DOCKER_USER := "spilikin"

# Pinned Go code-analysis tools (run via `go run`; not added to any go.mod)
MODERNIZE := "golang.org/x/tools/gopls/internal/analysis/modernize/cmd/modernize@v0.22.0"
# Development build: no release reads go1.27 export data yet (2026.2.1 stops at
# version 4); move to the first release that does.
STATICCHECK := "honnef.co/go/tools/cmd/staticcheck@v0.7.0-0.dev.0.20261009230814-452d5bb86b45"
GOVULNCHECK := "golang.org/x/vuln/cmd/govulncheck@v1.9.0"
# golangci-lint v2.14 is the first release that reads Go 1.27 export data.
GOLANGCI := "github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.14.0"

# Every variable a gated test reads: `just test` must not reach a live system because a
# shell or ./.env happens to set one.
_UNGATE := "unset EPA_KVNRS_FILE EPA_POPP_TOKEN EPA_REPORT EPA_SMCB_CERT EPA_SMCB_KEY EPA_SMCB_P12 EPA_SMCB_P12_PASSWORD EPA_SMCB_P12_PASSWORD_PATH EPA_TI_BIN EPA_VAU_BASE_URL EPA_VAU_CERT_VERIFY IDPD_BASE_URL IDPD_CLIENT_ID IDPD_REDIRECT_URI IDPD_SCOPE IDPD_SMCB_P12 IDPD_SMCB_P12_PASSWORD IDPD_SMCB_REPORT IDPD_TRUST_BUNDLE_PATH IDPD_TRUST_FETCH OIDF_FEDMASTER_URL PEP_PG_DSN TEST_DATABASE_URL VSDM_HMAC_KEY VSDM_HMAC_KID ZERO_PDP_E2E_CLIENT2_ID ZERO_PDP_E2E_CLIENT2_KEY_PATH ZERO_PDP_E2E_HITL ZERO_PDP_E2E_URL"

# The gematik OpenAPI ruleset lives in the internal GitLab project dev-portal/api-tools and
# has no licence, so it is never copied here: `api-lint` runs it from a local clone at
# GEMATIK_API_TOOLS_DIR, pinned to this revision and the Spectral version it is tested with.
API_RULESET_REV := "d698980"
SPECTRAL := "@stoplight/spectral-cli@6.11.1"

# List the recipes
default:
    @just --list

# (internal) Run a command in every module; every failure counts, and all modules run.
_each cmd:
    #!/usr/bin/env bash
    set -uo pipefail
    fail=0
    for dir in $(find . -name go.mod -exec dirname {} \; | sort); do
        echo "==> $dir"
        ( cd "$dir" && {{cmd}} ) || fail=1
    done
    exit $fail

# --- Checks ---

# Every check of a change
check: lint golangci modernize vuln mod-check test test-race api-lint

# go vet and staticcheck
lint: (_each "go vet ./... && go run " + STATICCHECK + " ./...")

# golangci-lint with .golangci.yml, linters and formatters
golangci: (_each "go run " + GOLANGCI + " run ./... && go run " + GOLANGCI + " fmt --diff ./...")

# Report outdated idioms; the generated fiat code keeps its generator's output
modernize: (_each "found=$(go run " + MODERNIZE + " ./... 2>&1 | grep -vE '/bp256/fiat/|^exit status'); echo \"$found\"; [ -z \"$found\" ]")

# Apply modernize's fixes, tests included
modernize-fix: (_each "go run " + MODERNIZE + " -fix -test ./...; gofmt -w .")
    git checkout -- brainpool/internal/bp256/fiat

# Known vulnerabilities
vuln: (_each "go run " + GOVULNCHECK + " ./...")

# go.mod and go.sum as `go mod tidy` leaves them, with sums matching what was downloaded;
# openid and oidf carry no TI trust path in their module graph, and base libraries compile no
# format dependency (decision-13)
mod-check: (_each "go mod tidy -diff && go mod verify")
    #!/usr/bin/env bash
    set -uo pipefail
    fail=0
    for dir in openid oidf; do
        found=$(cd "$dir" && GOWORK=off go list -m all | grep -E 'zero-lab/go/(brainpool|tipki|pkcs12|idpd)( |$)')
        if [ -n "$found" ]; then echo "$dir carries: $found"; fail=1; fi
    done
    found=$(cd pep && GOWORK=off go list -m all | grep 'zero-lab/go/' | grep -vE 'zero-lab/go/(pep|dpop)( |$)')
    if [ -n "$found" ]; then echo "pep, which zaddy takes in, carries: $found"; fail=1; fi
    for dir in brainpool dpop idpd kv nonce oidf openid pep pkcs12 tipki; do
        found=$(cd "$dir" && GOWORK=off go list -deps ./... | grep -E 'yaml')
        if [ -n "$found" ]; then echo "$dir compiles: $found"; fail=1; fi
        if grep -qE 'yaml' "$dir/go.mod"; then echo "$dir/go.mod names yaml"; fail=1; fi
    done
    exit $fail

# Tests, built as the images are. Gated suites have their own recipes and never run here.
test: (_each _UNGATE + "; go test -count=1 ./...")

# Tests under the race detector, which needs cgo on Linux
test-race: (_each _UNGATE + "; CGO_ENABLED=1 go test -race -count=1 ./...")

# Lint every OpenAPI contract with the gematik ruleset; skipped without GEMATIK_API_TOOLS_DIR
# unless REQUIRE_API_LINT=1 (internal CI)
api-lint:
    #!/usr/bin/env bash
    set -euo pipefail
    dir="${GEMATIK_API_TOOLS_DIR:-}"
    if [[ -z "$dir" || ! -f "$dir/openapi/spectral/ruleset.yml" ]]; then
        msg="api-lint: no gematik ruleset; set GEMATIK_API_TOOLS_DIR to a clone of dev-portal/api-tools"
        if [[ "${REQUIRE_API_LINT:-}" == 1 ]]; then echo "$msg" >&2; exit 1; fi
        echo "$msg (skipped)"; exit 0
    fi
    head=$(git -C "$dir" rev-parse HEAD)
    if [[ "$head" != {{API_RULESET_REV}}* ]]; then
        echo "api-lint: $dir is at ${head:0:7}, pinned {{API_RULESET_REV}}: git -C \"$dir\" checkout {{API_RULESET_REV}}" >&2
        exit 1
    fi
    root=$(git rev-parse --show-toplevel)
    specs=()
    while IFS= read -r f; do
        grep -qE '^openapi:|"openapi"[[:space:]]*:' "$root/$f" && specs+=("$root/$f")
    done < <(git -C "$root" ls-files '*.yaml' '*.yml' '*.json')
    if (( ${#specs[@]} == 0 )); then echo "api-lint: no OpenAPI contracts"; exit 0; fi
    # Warnings are conventions to follow too, so they fail the lint as errors do.
    npx -y {{SPECTRAL}} lint --fail-severity=warn --ruleset "$dir/openapi/spectral/ruleset.yml" "${specs[@]}"

# --- Modules ---

# Sync go.mod and go.sum with imports, upgrading nothing
tidy: (_each "go mod tidy")

# Upgrade all dependencies; re-run `just sync` before a release
upgrade: (_each "go get -u ./... && go mod tidy")

# Repin every in-repo require to a git ref (default: this branch), for builds outside the
# workspace, and drop the local replaces. Push first: pins resolve from the remote. Each version is derived from the
# module's own go/<mod>/v* tag, since go get bases pseudo-versions on the highest repo-wide tag.
sync REF=`git rev-parse --abbrev-ref HEAD`:
    #!/usr/bin/env bash
    set -euo pipefail
    export GOPRIVATE=github.com/gematik/zero-lab
    commit=$(git rev-parse "{{REF}}")
    short=$(git rev-parse --short=12 "$commit")
    ts=$(TZ=UTC git show -s --date=format-local:%Y%m%d%H%M%S --format=%cd "$commit")
    # modver <name>: the version to require for go/<name> at $commit — its tag if
    # the tag is at $commit, otherwise a correctly-based pseudo-version above the
    # highest tag that is an ANCESTOR of $commit (Go rejects a pseudo-version whose
    # base tag is not an ancestor, and tags may live off-main).
    modver() {
        local tag best="" ma mi pa
        for tag in $(git tag -l "go/$1/v*" | sort -V); do
            git merge-base --is-ancestor "$(git rev-list -n1 "$tag")" "$commit" 2>/dev/null && best="$tag"
        done
        if [ -z "$best" ]; then
            echo "v0.0.0-$ts-$short"
        elif [ "$(git rev-list -n1 "$best")" = "$commit" ]; then
            echo "${best##*/}"
        elif [[ "${best##*/v}" == *-* ]]; then
            # Above a pre-release vX.Y.Z-pre the pseudo-version is vX.Y.Z-pre.0.<time>-<hash>.
            echo "${best##*/}.0.$ts-$short"
        else
            IFS=. read -r ma mi pa <<<"${best##*/v}"
            echo "v$ma.$mi.$((pa+1))-0.$ts-$short"
        fi
    }
    for dir in $(find . -name 'go.mod' -exec dirname {} \;); do
        ( cd "$dir"
          self=$(awk 'NR==1{print $2}' go.mod)
          for dep in $(grep -oE 'github\.com/gematik/zero-lab/go/[a-zA-Z0-9]+' go.mod | sort -u); do
              [ "$dep" = "$self" ] && continue
              ver=$(modver "${dep##*/}")
              echo "==> $self: $dep@$ver"
              # Not go get, which cannot move past the placeholder of a module not yet on the remote.
              go mod edit -dropreplace="$dep" -require="$dep@$ver"
          done
          # Tidy as a build outside the workspace sees the module (`go install …@tag`).
          GOWORK=off go mod tidy )
    done
    go work sync
    # go work sync raises versions to what the workspace selects, so tidy again or go.sum
    # lacks their entries for a build outside the workspace.
    for dir in $(find . -name 'go.mod' -exec dirname {} \; | sort); do
        ( cd "$dir" && GOWORK=off go mod tidy )
    done

# Tag a module: `just tag brainpool 0.3.1`. Modules are versioned solely by their own tags.
tag name version:
    git tag -a "go/{{name}}/v{{version}}" -m "{{name}} v{{version}}"

# Push all local tags
push-tags:
    git push origin --tags

# Show every module's latest tag
versions:
    #!/usr/bin/env bash
    for dir in $(find . -name go.mod -exec dirname {} \; | sed 's|^\./||' | sort); do
        printf '%-12s %s\n' "$dir" "$(git tag -l "go/$dir/v*" | sort -V | tail -1)"
    done

# List modules with commits since their latest tag
changed:
    #!/usr/bin/env bash
    for dir in $(find . -name go.mod -exec dirname {} \; | sed 's|^\./||' | sort); do
        latest=$(git tag -l "go/$dir/v*" | sort -V | tail -1)
        if [ -z "$latest" ]; then echo "$dir: never tagged"
        elif [ -n "$(git log --oneline "$latest"..HEAD -- "$dir")" ]; then echo "$dir: changed since $latest"; fi
    done

# --- Images: epa, pdp, pep, caddy, metsubushi ---

# (internal) A module's plain version from its latest tag, else "dev". zero-epa sends it in the
# x-useragent header, which the ePA aggregators validate, so it must stay strictly SemVer.
_modver mod:
    #!/usr/bin/env bash
    v=$(git describe --tags --match "go/{{mod}}/v*" 2>/dev/null | sed 's|.*/v||; s/-[0-9]\{1,\}-g[0-9a-f]\{1,\}$//')
    echo "${v:-dev}"

# Build an image, tagged with its version and latest
docker-build name:
    #!/usr/bin/env bash
    set -euo pipefail
    context=.
    case "{{name}}" in
        # The epa image builds the Rust ti, so its context is the repository root.
        epa) mod=epa image=zero-epa file=epa/cmd/zero-epa/Dockerfile context=.. ;;
        pdp) mod=pdp image=zero-pdp file=pdp/cmd/zero-pdp/Dockerfile ;;
        pep) mod=pep/proxy image=zero-pep-proxy file=pep/proxy/cmd/zero-pep-proxy/Dockerfile ;;
        caddy) mod=zaddy image=zero-caddy file=zaddy/cmd/zero-caddy/Dockerfile ;;
        metsubushi) mod=metsubushi image=metsubushi file=metsubushi/Dockerfile ;;
        *) echo "unknown image {{name}}" >&2; exit 1 ;;
    esac
    v=$(just _modver "$mod")
    tag=$v
    # The caddy tag carries the upstream version from zaddy/go.mod as well.
    if [ "{{name}}" = caddy ]; then tag=$v-caddy$(awk '/caddyserver\/caddy\/v2 v[0-9]/{sub(/^v/,"",$2); print $2; exit}' zaddy/go.mod); fi
    docker build --platform linux/amd64 --build-arg VERSION="$v" -t "{{DOCKER_USER}}/$image:$tag" -f "$file" "$context"
    docker tag "{{DOCKER_USER}}/$image:$tag" "{{DOCKER_USER}}/$image:latest"
    echo "{{DOCKER_USER}}/$image:$tag"

# Build and push an image
docker-push name: (docker-build name)
    #!/usr/bin/env bash
    set -euo pipefail
    just docker-build {{name}} | tail -1 | xargs docker push
    docker push "{{DOCKER_USER}}/$(case {{name}} in pep) echo zero-pep-proxy;; caddy) echo zero-caddy;; metsubushi) echo metsubushi;; *) echo zero-{{name}};; esac):latest"

# --- Gated suites: docs/development.md, "Gated tests" ---

# Start zero-pdp for e2e against URL, serving the e2e testdata
pdp-e2e-serve URL='http://localhost:8011':
    #!/usr/bin/env bash
    set -euo pipefail
    td=pdp/e2e/testdata
    [ -f "$td/sign.jwk" ] || go run ./pdp/cmd/zero-pdp jose generate-jwk > "$td/sign.jwk"
    export ZERO_PDP_E2E_URL='{{URL}}'
    export ZERO_PDP_E2E_CLIENT_ID="${ZERO_PDP_E2E_CLIENT_ID:-e2e-client}"
    export ZERO_PDP_E2E_REDIRECT_URI="${ZERO_PDP_E2E_REDIRECT_URI:-http://localhost:8765/as-callback}"
    go run ./pdp/cmd/zero-pdp start -f pdp.e2e.yaml -w "$td"

# Run the e2e suites against a running server; TESTS narrows them, e.g. Smoke
pdp-e2e URL='http://localhost:8011' TESTS='Smoke|Regression|Flow':
    ZERO_PDP_E2E_URL='{{URL}}' go test ./pdp/e2e -run '{{TESTS}}' -count=1 -v

# Run the authorization-code flow in a browser, against the public URL
pdp-e2e-hitl URL:
    ZERO_PDP_E2E_URL='{{URL}}' ZERO_PDP_E2E_HITL=1 go test ./pdp/e2e -run HITL -count=1 -v -timeout 5m

# A full SMC-B login at the gematik IDP
idpd-smcb-test:
    go test ./idpd -run TestIDPD_SMCB -count=1 -v -timeout 2m

# The reference IDP's certificates, live, against IDPD_TRUST_BUNDLE_PATH
idpd-trust-test:
    go test ./idpd -run TestIDPV005TheLiveReferenceIDP -count=1 -v -timeout 2m

# The reference IDP's certificates, live, with the trust material downloaded
idpd-trust-fetch-test:
    IDPD_TRUST_FETCH=1 go test ./idpd -run TestIDPV007TheLiveReferenceEnvironment -count=1 -v -timeout 3m

# ePA connect at both providers (VAU, authorize, record status, consent)
epa-connect-test:
    go test ./epa -run TestEPA_Connect -count=1 -v -timeout 5m

# ePA entitlement. VSDM_HMAC_KEY and VSDM_HMAC_KID come from the shell, never from ./.env
epa-entitle-test:
    go test ./epa -run TestEPA_Entitle -count=1 -v -timeout 5m

# OpenID Federation against the master in OIDF_FEDMASTER_URL
oidf-test:
    go test ./oidf -run TestFederation -count=1 -v -timeout 2m
