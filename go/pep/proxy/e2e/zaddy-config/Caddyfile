{
	auto_https off
	pep {
		# zaddy requires the resource tokens are meant for (RFC 9700 Section 4.10.2). go/pdp, frozen, issues its
		# tokens without aud and with typ JWT, so this setup refuses them since TASK-366.
		resource http://localhost:8010
		accept_untyped_access_tokens
		jwks_path /etc/caddy/pdp-jwks.json
		# Where pep-proxy reaches this server (PEP_API_UPSTREAM): the origin DPoP proofs name in htu.
		public_origin http://localhost:8010
	}
}
:8010 {
	route /protected-dpop {
		enforce_policy {
			authorization_dpop
			scope protected
		}
		respond "OK: zaddy verified the DPoP-bound access token" 200
	}
}
