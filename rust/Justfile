# Pinned cargo tools (installed with `just tools`; versions are the single source of truth)
NEXTEST       := "cargo-nextest@0.9.146"
DENY          := "cargo-deny@0.20.2"
AUDIT         := "cargo-audit@0.22.2"
VET           := "cargo-vet@0.10.2"
HACK          := "cargo-hack@0.6.45"
MACHETE       := "cargo-machete@0.9.2"
SEMVER_CHECKS := "cargo-semver-checks@0.50.0"
MSRV          := "cargo-msrv@0.19.3"
MUTANTS       := "cargo-mutants@27.1.0"
RELEASE_PLZ   := "release-plz@0.3.169"
CROSS         := "cross@0.2.5"
BLOAT         := "cargo-bloat@0.12.1"
# Must equal the wasm-bindgen pin in ti-wasm/Cargo.toml.
WASM_BINDGEN  := "wasm-bindgen-cli@0.2.128"
# jwz with every feature but `rsa`, which refuses to build until RSA is implemented
# (`jwz-rsa-guard` proves that); workspace-wide `--all-features` runs exclude jwz.
JWZ_FEATURES  := "std,jws,jwe,jwt,crypto-rustcrypto,hmac,test-util"

# Every crate is versioned solely by its own git tag (rust/<crate>/vX.Y.Z), bumped only
# when that crate changes. Siblings resolve each other through the `version` in
# [workspace.dependencies], which a bump must raise too (see docs/development.md).

# Display available commands
info:
    just --list

# Install the pinned tools (use cargo-binstall when available, it avoids compiling)
tools:
    #!/usr/bin/env bash
    set -euo pipefail
    for t in {{NEXTEST}} {{DENY}} {{AUDIT}} {{VET}} {{HACK}} {{MACHETE}} {{SEMVER_CHECKS}} {{MSRV}} {{MUTANTS}} {{RELEASE_PLZ}} {{CROSS}} {{BLOAT}} {{WASM_BINDGEN}}; do
        if command -v cargo-binstall >/dev/null; then cargo binstall -y "$t"; else cargo install --locked "$t"; fi
    done

# ---- The ti command-line tool -------------------------------------------------------

# Install `ti` into ~/.cargo/bin
install:
    cargo install --path ti-cli --locked --force

# Install a quicker build of `ti` for testing turnarounds (profile `local`: thin LTO, incremental)
install-fast:
    cargo build --profile local --locked -p ti-cli
    install -m 755 target/local/ti "${CARGO_HOME:-$HOME/.cargo}/bin/ti"

# Linux (static musl) and Windows are built through cross in Docker, macOS natively on
# a Mac; needs `just tools` and a running Docker daemon.
# Release binaries of the CLI for every distributed platform into target/dist
cli-targets:
    #!/usr/bin/env bash
    set -euo pipefail
    command -v cross >/dev/null || { echo "cross is missing: just tools" >&2; exit 1; }
    docker info >/dev/null 2>&1 || { echo "the Docker daemon is not running" >&2; exit 1; }
    meta=$(cargo metadata --no-deps --format-version 1 \
        | jq -r '.packages[] | select(.name == "ti-cli")
                 | "\(.version) \(.targets[] | select(.kind[] == "bin") | .name)"')
    read -r version bin <<< "$meta"
    targets=(x86_64-unknown-linux-musl x86_64-pc-windows-gnu)
    native=()
    if [[ "$(uname -s)" == Darwin ]]; then native=(aarch64-apple-darwin); fi
    # cross runs a Linux toolchain inside its container; rustup refuses to install one on
    # a non-Linux host unless forced, and cross 0.2.5 does not force it.
    if [[ "$(uname -s)" != Linux ]]; then
        rustup toolchain add stable-x86_64-unknown-linux-gnu --profile minimal --force-non-host >/dev/null
    fi
    # cross's images are amd64 only; elsewhere (Apple silicon) Docker runs them emulated.
    if [[ "$(uname -m)" != x86_64 ]]; then
        export CROSS_CONTAINER_OPTS="${CROSS_CONTAINER_OPTS:-} --platform linux/amd64"
    fi
    # A release uploads everything here, so nothing from an earlier build may remain.
    rm -rf target/dist && mkdir -p target/dist
    for t in "${targets[@]}" "${native[@]}"; do
        echo "==> $t"
        if [[ " ${native[*]} " == *" $t "* ]]; then
            rustup target add "$t" >/dev/null
            cargo build --release --locked -p ti-cli --target "$t"
            out=target
        else
            # One target directory per cross image: the images differ in glibc, so build
            # scripts compiled in one fail to run in another.
            out="target/cross/$t"
            CARGO_TARGET_DIR="$out" cross build --release --locked -p ti-cli --target "$t"
        fi
        ext=""; [[ "$t" == *windows* ]] && ext=".exe"
        cp "$out/$t/release/$bin$ext" "target/dist/$bin-$version-$t$ext"
        echo "target/dist/$bin-$version-$t$ext"
    done

# Run the development build: just ti pki inspect card.pem
ti *ARGS:
    cargo run -q -p ti-cli -- {{ARGS}}

# ---- Releasing ti -----------------------------------------------------------------
# `just release` works locally (gate, bump, build, commit, tag); `just publish` pushes and
# publishes the GitHub release with the binaries, then the Homebrew formula.

REPO := "gematik/zero-lab"
# The GitHub user or organization whose homebrew-tap repository carries the formula.
TAP_OWNER := "spilikin"

# A crate's release notes from ReleaseNotes.md: those of a version, or its pending ones (just release-notes Unreleased ti-pki)
release-notes version="Unreleased" crate="ti-cli":
    #!/usr/bin/env bash
    set -euo pipefail
    notes=$(VERSION="{{version}}" CRATE="{{crate}}" perl -0777 -ne '
        my ($v, $c) = ($ENV{VERSION}, $ENV{CRATE});
        if ($v eq "Unreleased") {
            my ($u) = /^## Unreleased\n(.*?)(?=^## |\z)/ms or exit;
            my ($b) = $u =~ /^### \Q$c\E\n(.*?)(?=^### |\z)/ms or exit;
            $b =~ s/^####/###/mg;
            print $b;
        } else {
            print $1 if /^## Release \Q$c $v\E,[^\n]*\n(.*?)(?=^## |\z)/ms;
        }' ReleaseNotes.md | sed -e '/[^[:space:]]/,$!d')
    [[ -n "$notes" ]] || { echo "release-notes: no notes for {{crate}} {{version}}" >&2; exit 1; }
    printf '%s\n' "$notes"

# Prepare a ti release from main, locally: gate, version bump, release notes, binaries in target/dist, commit and tag
release version:
    #!/usr/bin/env bash
    set -euo pipefail
    v="{{version}}"; tag="rust/ti-cli/v$v"
    die() { echo "release: $*" >&2; exit 1; }
    [[ "$(git branch --show-current)" == main ]] || die "releases start from main"
    [[ -z "$(git status --porcelain)" ]] || die "the working tree is not clean"
    git fetch -q origin main
    [[ "$(git rev-parse main)" == "$(git rev-parse origin/main)" ]] || die "main and origin/main differ"
    ! git rev-parse -q --verify "refs/tags/$tag" >/dev/null || die "$tag exists"
    last=$(git tag -l 'rust/ti-cli/v*' | sed 's|.*/v||' | sort -V | tail -1)
    [[ -z "$last" || "$(printf '%s\n%s\n' "$last" "$v" | sort -V | tail -1)" == "$v" && "$v" != "$last" ]] \
        || die "$v is not above the last release $last"
    just release-notes >/dev/null || die "write the release notes first"

    echo "==> just check"; just check
    echo "==> just audit"; just audit

    # From here the working tree changes; a failure or Ctrl-C before the commit undoes it.
    undo() { git checkout -q -- ti-cli/Cargo.toml Cargo.lock ReleaseNotes.md; echo "release: stopped, the bump is undone" >&2; }
    trap undo ERR
    trap 'undo; exit 130' INT
    perl -0pi -e 's/^version = "[^"]*"/version = "'"$v"'"/m' ti-cli/Cargo.toml
    cargo update -q -p ti-cli --offline
    # ti-cli's block leaves "Unreleased" and becomes the section of this release.
    CRATE=ti-cli HEADING="## Release ti-cli $v, $(date +%F)" perl -0777 -i -pe '
        my ($c, $h) = ($ENV{CRATE}, $ENV{HEADING});
        s{^## Unreleased\n(.*?)(?=^## |\z)}{
            my $u = $1;
            $u =~ s{^### \Q$c\E\n(.*?)(?=^### |\z)}{}ms;
            my $b = $1;
            $b =~ s/^####/###/mg;
            $u =~ s/\s+\z/\n/;
            $u = "" unless $u =~ /\S/;
            "## Unreleased\n$u\n$h\n$b"
        }mse;
        s/\n+\z/\n/' ReleaseNotes.md
    echo "==> just cli-targets"; just cli-targets
    (cd target/dist && shasum -a 256 "ti-$v-"* > SHA256SUMS)
    trap - ERR INT

    git add ti-cli/Cargo.toml Cargo.lock ReleaseNotes.md
    git commit -q -m "ti-cli: release $v"
    just tag ti-cli "$v"
    echo; just release-notes "$v"; echo; ls -l target/dist
    echo
    echo "Committed and tagged $tag, nothing pushed. Publish with: just publish $v"
    echo "or undo: git tag -d $tag && git reset --keep HEAD~1"

# Publish a ti release made by `just release`: push main and its tag, the GitHub release with target/dist, the formula in <tap>/homebrew-tap; safe to re-run
publish version tap=TAP_OWNER:
    #!/usr/bin/env bash
    set -euo pipefail
    v="{{version}}"; tag="rust/ti-cli/v$v"
    git rev-parse -q --verify "refs/tags/$tag" >/dev/null || { echo "publish: no tag $tag" >&2; exit 1; }
    [[ -f target/dist/SHA256SUMS ]] || { echo "publish: no binaries in target/dist" >&2; exit 1; }
    notes=$(mktemp); trap 'rm -f "$notes"' EXIT
    {
        just release-notes "$v"
        echo
        echo "---"
        echo
        echo "**Install** on macOS and Linux: \`brew install {{tap}}/tap/ti\`, update with \`brew upgrade ti\`."
        echo
        echo "**Verify** a download: \`shasum -a 256 -c SHA256SUMS --ignore-missing\`"
    } > "$notes"
    git push --atomic origin main "$tag"
    # Re-running after a partial publish skips what is already there.
    if gh release view "$tag" --repo {{REPO}} >/dev/null 2>&1; then
        echo "GitHub release $tag exists"
    else
        gh release create "$tag" --repo {{REPO}} --verify-tag --title "ti $v" --notes-file "$notes" \
            target/dist/SHA256SUMS target/dist/ti-"$v"-*
    fi
    just publish-brew {{tap}} "$v"

# Point the ti formula in <owner>/homebrew-tap at a published release, from its checksums
publish-brew owner version:
    #!/usr/bin/env bash
    set -euo pipefail
    v="{{version}}"; tag="rust/ti-cli/v$v"
    work=$(mktemp -d); trap 'rm -rf "$work"' EXIT
    gh release download "$tag" --repo {{REPO}} -p SHA256SUMS -D "$work"
    assets=$(gh release view "$tag" --repo {{REPO}} --json assets --jq '.assets[] | "\(.name) \(.url)"')
    args=(-e "s|@VERSION@|$v|g")
    for target in aarch64-apple-darwin x86_64-unknown-linux-musl; do
        name="ti-$v-$target"
        sum=$(awk -v f="$name" '$2 == f {print $1}' "$work/SHA256SUMS")
        url=$(awk -v f="$name" '$1 == f {print $2}' <<< "$assets")
        [[ -n "$sum" && -n "$url" ]] || { echo "publish-brew: $tag has no $name" >&2; exit 1; }
        args+=(-e "s|@URL_$target@|$url|" -e "s|@SHA256_$target@|$sum|")
    done
    gh repo clone "{{owner}}/homebrew-tap" "$work/tap" -- -q --depth 1
    mkdir -p "$work/tap/Formula"
    sed "${args[@]}" ti-cli/Formula/ti.rb > "$work/tap/Formula/ti.rb"
    git -C "$work/tap" add Formula/ti.rb
    git -C "$work/tap" diff --cached --quiet || {
        git -C "$work/tap" commit -q -m "ti $v"
        git -C "$work/tap" push -q
    }
    echo "brew install {{owner}}/tap/ti"

# ---- WebAssembly (ti-wasm) ----------------------------------------------------------

WASM_PKG := "target/ti-wasm/pkg"

# wasm-bindgen ES module, wasm-opt when binaryen is installed (brew install binaryen),
# package.json, types, schemas and VERSION.json
# Build the ti-wasm package into target/ti-wasm/pkg
wasm-build:
    #!/usr/bin/env bash
    set -euo pipefail
    want=$(sed -n 's/^wasm-bindgen = "=\(.*\)"$/\1/p' ti-wasm/Cargo.toml)
    have=$(wasm-bindgen --version 2>/dev/null | awk '{print $2}') || true
    [[ "$have" == "$want" ]] || { echo "wasm-build: wasm-bindgen-cli $want needed, found '${have:-none}': just tools" >&2; exit 1; }
    cargo build --profile wasm --locked -p ti-wasm --target wasm32-unknown-unknown
    rm -rf {{WASM_PKG}} && mkdir -p {{WASM_PKG}}
    wasm-bindgen --target web --out-dir {{WASM_PKG}} target/wasm32-unknown-unknown/wasm/ti_wasm.wasm
    opt=null
    if command -v wasm-opt >/dev/null; then
        # The features rustc's wasm32 target emits by default; speed over size (-O3).
        wasm-opt -O3 --enable-bulk-memory --enable-nontrapping-float-to-int --enable-sign-ext \
            --enable-mutable-globals --enable-reference-types --enable-multivalue \
            -o {{WASM_PKG}}/ti_wasm_bg.wasm {{WASM_PKG}}/ti_wasm_bg.wasm
        opt="\"$(wasm-opt --version | awk '{print $3}')\""
    else
        echo "wasm-build: wasm-opt not found, the module is not optimized (brew install binaryen)" >&2
    fi
    cp ti-wasm/js/package.json ti-wasm/js/types.d.ts ti-wasm/js/README.md ti-wasm/schemas/*.json {{WASM_PKG}}/
    version=$(sed -n 's/^version = "\(.*\)"$/\1/p' ti-wasm/Cargo.toml | head -1)
    dirty=false; [[ -z "$(git status --porcelain -- . ../spec)" ]] || dirty=true
    cat > {{WASM_PKG}}/VERSION.json <<JSON
    {
      "ti_wasm": "$version",
      "commit": "$(git rev-parse HEAD)",
      "dirty": $dirty,
      "rustc": "$(rustc --version | awk '{print $2}')",
      "wasm_bindgen": "$have",
      "wasm_opt": $opt,
      "wasm_sha256": "$(shasum -a 256 {{WASM_PKG}}/ti_wasm_bg.wasm | awk '{print $1}')"
    }
    JSON
    echo "built {{WASM_PKG}}"

# Size of the built module, raw and compressed; fails over the budget (2.0 MB raw, 700 KB gzip)
wasm-size:
    #!/usr/bin/env bash
    set -euo pipefail
    wasm={{WASM_PKG}}/ti_wasm_bg.wasm
    [[ -f "$wasm" ]] || { echo "wasm-size: no $wasm: just wasm-build" >&2; exit 1; }
    raw=$(wc -c < "$wasm" | tr -d ' ')
    gz=$(gzip -9c "$wasm" | wc -c | tr -d ' ')
    br=$(command -v brotli >/dev/null && brotli -c "$wasm" | wc -c | tr -d ' ' || echo "-")
    printf 'ti_wasm_bg.wasm  raw %s  gzip %s  brotli %s bytes\n' "$raw" "$gz" "$br"
    (( raw <= 2000000 )) || { echo "wasm-size: raw $raw over 2000000" >&2; exit 1; }
    (( gz <= 700000 )) || { echo "wasm-size: gzip $gz over 700000" >&2; exit 1; }

# Run the built package in Node on the real TSLs, cross-checked with `ti pki tsl verify`
wasm-smoke: wasm-build
    cargo build --locked -q -p ti-cli
    node ti-wasm/js/smoke.mjs {{WASM_PKG}} ../spec/tsl-xmldsig/testdata/tsl/real target/debug/ti

# Refuses an unoptimized or dirty build.
# Copy the package into a consumer as vendor/ti-wasm, after smoke and size pass
wasm-vendor dest="../../gemiverse": wasm-smoke wasm-size
    #!/usr/bin/env bash
    set -euo pipefail
    v={{WASM_PKG}}/VERSION.json
    grep -q '"dirty": false' "$v" || { echo "wasm-vendor: built from a dirty tree; commit first" >&2; exit 1; }
    grep -q '"wasm_opt": null' "$v" && { echo "wasm-vendor: not optimized; brew install binaryen" >&2; exit 1; }
    [[ -d "{{dest}}" ]] || { echo "wasm-vendor: no {{dest}}" >&2; exit 1; }
    mkdir -p "{{dest}}/vendor/ti-wasm"
    rsync -a --delete {{WASM_PKG}}/ "{{dest}}/vendor/ti-wasm/"
    cat "{{dest}}/vendor/ti-wasm/VERSION.json"

# ---- Tier 1: every PR --------------------------------------------------------------

# Everything a PR must pass, in the order that fails fastest
check: fmt clippy doc test features wasm32 wasm-unsafe-free core-deps nonprod-absent jwz-backends jwz-rsa-guard machete deny
    just brainpool-absent jwz
    just brainpool-absent ti-jwz

# Formatting (rustfmt.toml is the source of truth)
fmt:
    cargo fmt --all -- --check

# Clippy on all targets with all features and with the defaults; warnings are errors.
# The default pass catches code that only a feature makes used (e.g. test imports).
clippy:
    cargo clippy --workspace --exclude jwz --all-targets --all-features -- -D warnings
    cargo clippy -p jwz --all-targets --features {{JWZ_FEATURES}} -- -D warnings
    cargo clippy --workspace --all-targets -- -D warnings

# Rustdoc must build warning-free (broken intra-doc links, missing docs)
doc:
    RUSTDOCFLAGS="-D warnings" cargo doc --workspace --exclude jwz --no-deps --all-features
    RUSTDOCFLAGS="-D warnings" cargo doc -p jwz --no-deps --features {{JWZ_FEATURES}}

# Tests via nextest (parallel, per-test timeouts, better failure output) with all
# features and with the defaults, then doctests
test:
    cargo nextest run --workspace --exclude jwz --all-features
    cargo nextest run -p jwz --features {{JWZ_FEATURES}}
    cargo nextest run --workspace
    cargo test --workspace --exclude jwz --all-features --doc
    cargo test -p jwz --features {{JWZ_FEATURES}} --doc

# The cache, XML signature checking, the loading layer, the reqwest transport and PKCS#12 decoding build for
# the browser
wasm32:
    cargo check -p ti-cache --target wasm32-unknown-unknown
    cargo check -p ti-xmldsig --target wasm32-unknown-unknown
    cargo check -p ti-connector-client --target wasm32-unknown-unknown
    cargo check -p ti-pki --target wasm32-unknown-unknown --features load,reqwest
    cargo check -p ti-pkcs12 --target wasm32-unknown-unknown
    cargo check -p ti-report --target wasm32-unknown-unknown
    cargo check -p ti-wasm --target wasm32-unknown-unknown
    cargo check -p jwz --target wasm32-unknown-unknown --features {{JWZ_FEATURES}}
    cargo check -p jwz --target wasm32-unknown-unknown --no-default-features
    cargo check -p jwz-brainpool --target wasm32-unknown-unknown
    cargo check -p ti-jwz --target wasm32-unknown-unknown --all-features

# ti-wasm allows the unsafe glue `#[wasm_bindgen]` expands to; everything else forbids it
# through the workspace lints.
# No `unsafe` in ti-wasm's own sources
wasm-unsafe-free:
    ! grep -rnw unsafe ti-wasm/src

# ti-pki's and ti-connector-client's cores (everything but the optional adapter and
# algorithm features) pull in no HTTP client, TLS, executor, file watcher or brainpool
# arithmetic; cargo-deny bans are workspace-wide, so this is a tree check
core-deps:
    #!/usr/bin/env bash
    set -euo pipefail
    found=$(cargo tree -p ti-pki -e normal --prefix none --no-default-features \
            --features load,os,test-util,dangerous-nonprod \
        | grep -E '^(reqwest|tokio|hyper|notify|bp256|bp384) ' || true)
    if [ -n "$found" ]; then echo "ti-pki core depends on: $found" >&2; exit 1; fi
    echo "ti-pki core is free of HTTP clients, executors, file watchers and brainpool"
    found=$(cargo tree -p ti-connector-client -e normal --prefix none \
        | grep -E '^(reqwest|ureq|rustls|tokio|hyper|bp256|bp384|rsa) ' || true)
    if [ -n "$found" ]; then echo "ti-connector-client core depends on: $found" >&2; exit 1; fi
    echo "ti-connector-client core is free of HTTP clients, TLS, executors and brainpool"

# Without dangerous-nonprod, the compiled ti-pki must contain none of the non-prod trust
# files. Compares their bytes, not a marker string (the marker legitimately occurs in
# code and docs), and repeats with the feature on so the check cannot pass vacuously.
nonprod-absent:
    #!/usr/bin/env bash
    set -euo pipefail
    files=(ti-pki/src/anchors/GEM.RCA7-TEST-ONLY.der ti-pki/src/anchors/GEM.RCA8-TEST-ONLY.der
           ti-pki/src/anchors/GEM.TSL-CA28-TEST-ONLY.der ti-pki/src/roots-nonprod.json)
    rlib() {
        cargo build -p ti-pki --message-format=json "$@" 2>/dev/null \
            | jq -r 'select(.reason == "compiler-artifact" and .target.name == "ti_pki") | .filenames[] | select(endswith(".rlib"))'
    }
    # Exact byte-substring search: does file $2 occur inside file $1?
    contains() { perl -0777 -e 'open(my $h, "<:raw", $ARGV[0]) or die; open(my $n, "<:raw", $ARGV[1]) or die; exit(index(<$h>, <$n>) < 0)' "$1" "$2"; }
    lib=$(rlib)
    for f in "${files[@]}"; do
        if contains "$lib" "$f"; then echo "non-prod material in $lib: $f" >&2; exit 1; fi
    done
    lib=$(rlib --features dangerous-nonprod)
    for f in "${files[@]}"; do
        contains "$lib" "$f" || { echo "check is blind: $f not found with dangerous-nonprod" >&2; exit 1; }
    done
    echo "no non-prod trust material without dangerous-nonprod"

# Only the jwz crates: the loop while working on jwz; `check` stays the gate before a commit.
# fmt, clippy, docs, tests, feature matrix, wasm32 and the guards for jwz, jwz-brainpool, ti-jwz
check-jwz:
    cargo fmt -p jwz -p jwz-brainpool -p ti-jwz -- --check
    cargo clippy -p jwz --all-targets --features {{JWZ_FEATURES}} -- -D warnings
    cargo clippy -p jwz -p jwz-brainpool -p ti-jwz --all-targets -- -D warnings
    cargo clippy -p jwz-brainpool -p ti-jwz --all-targets --all-features -- -D warnings
    RUSTDOCFLAGS="-D warnings" cargo doc -p jwz --no-deps --features {{JWZ_FEATURES}}
    RUSTDOCFLAGS="-D warnings" cargo doc -p jwz-brainpool -p ti-jwz --no-deps --all-features
    cargo nextest run -p jwz --features {{JWZ_FEATURES}}
    cargo nextest run -p jwz-brainpool -p ti-jwz --all-features
    cargo test -p jwz --features {{JWZ_FEATURES}} --doc
    cargo test -p jwz-brainpool -p ti-jwz --all-features --doc
    cargo hack check -p jwz --each-feature --exclude-features rsa --no-dev-deps
    cargo check -p jwz --target wasm32-unknown-unknown --features {{JWZ_FEATURES}}
    cargo check -p jwz --target wasm32-unknown-unknown --no-default-features
    cargo check -p jwz-brainpool --target wasm32-unknown-unknown
    cargo check -p ti-jwz --target wasm32-unknown-unknown --all-features
    just jwz-backends jwz-rsa-guard
    just brainpool-absent jwz
    just brainpool-absent ti-jwz

# rustls brings ring into ti-cli and ti-connector-client for TLS, so this is a tree check
# for the jwz crates rather than a deny ban (ADR 0001, principle 8).
# No openssl, ring, aws-lc or cryptoki under jwz, jwz-brainpool or ti-jwz
jwz-backends:
    #!/usr/bin/env bash
    set -euo pipefail
    for crate in jwz jwz-brainpool ti-jwz; do
        found=$(cargo tree -p "$crate" -e normal --prefix none --all-features \
            | grep -E '^(openssl|openssl-sys|ring|aws-lc-rs|aws-lc-sys|cryptoki) ' || true)
        if [ -n "$found" ]; then echo "$crate depends on: $found" >&2; exit 1; fi
    done
    echo "jwz, jwz-brainpool and ti-jwz are free of openssl, ring, aws-lc and cryptoki"

# jwz's `rsa` feature refuses to build until RSA crypto exists (milestone 1)
jwz-rsa-guard:
    #!/usr/bin/env bash
    set -euo pipefail
    if out=$(cargo check -q -p jwz --features rsa 2>&1); then
        echo "jwz builds with the rsa feature; the guard is gone" >&2; exit 1
    fi
    grep -q "rsa: not yet implemented" <<<"$out" || { echo "jwz --features rsa failed for another reason:" >&2; echo "$out" >&2; exit 1; }
    echo "jwz refuses the rsa feature"

# New components must not carry brainpool (ADR 0001); jwz-brainpool itself fails.
# No bp256, bp384 or jwz-brainpool in CRATE's tree with its default features
brainpool-absent crate:
    #!/usr/bin/env bash
    set -euo pipefail
    found=$(cargo tree -p {{crate}} -e normal --prefix none | grep -E '^(bp256|bp384|jwz-brainpool) ' || true)
    if [ -n "$found" ]; then echo "{{crate}} depends on brainpool: $found" >&2; exit 1; fi
    echo "{{crate}} is free of brainpool"

# Live tests against gematik's endpoints: roots.json and TSL of every environment,
# OCSP at real responders (network and curl required; not part of `check`)
real-world:
    cargo test -p ti-pki --features load,os,dangerous-nonprod --test real_world -- --ignored --nocapture --test-threads 1

# Regenerate the Konnektor bindings in ti-connector-client/src/api from the
# wsdl2openapi checkout next to this repository (or WSDL2OPENAPI_DIR)
generate-connector:
    #!/usr/bin/env bash
    set -euo pipefail
    gen="${WSDL2OPENAPI_DIR:-../../wsdl2openapi}/generator-rust"
    out="$PWD/ti-connector-client/src/api"
    rm -rf "$out"
    (cd "$gen" && cargo run -q -- --file ../Konnektor-OPB6.json --naming naming-kon.json \
        --module-root crate::api --select "$OLDPWD/ti-connector-client/api.select.json" --output "$out")
    cargo fmt -p ti-connector-client
    echo "generated by wsdl2openapi $(git -C "$gen" rev-parse --short HEAD)"

# Regenerate the OpenSSL test PKI in ti-pki/tests/pki (fresh keys, same topology)
test-pki:
    ti-pki/tests/pki/generate.sh
    ti-pki/tests/pki/tsl-signer/generate.sh

# Every feature alone and every pair of features must compile (catches feature-gated
# breakage); all features together are built by clippy --all-features
features:
    cargo hack check --workspace --exclude jwz --feature-powerset --depth 2 --no-dev-deps
    cargo hack check -p jwz --each-feature --exclude-features rsa --no-dev-deps
    # The tests too, where gating mistakes hide: ti-pki with none of its algorithm features.
    cargo test -p ti-pki --no-default-features --quiet

# Unused dependencies in Cargo.toml
machete:
    cargo machete --with-metadata

# Licences, bans, advisories, sources (deny.toml)
deny:
    cargo deny check

# ---- Tier 2: before tagging, and periodically on main ------------------------------

# Supply-chain and API tier
audit: advisories vet msrv semver

# RustSec advisories against Cargo.lock (overlaps deny's advisories check; kept separately
# because cargo-audit also reports yanked crates and can `cargo audit fix`)
advisories:
    cargo audit --deny warnings

# Supply-chain review status of every dependency (config in supply-chain/)
vet:
    cargo vet --locked

# Dependencies that cargo vet still needs a review for, most impactful first
vet-suggest:
    cargo vet suggest

# rust-version in Cargo.toml actually builds every crate (cargo-msrv has no --workspace)
msrv:
    #!/usr/bin/env bash
    set -euo pipefail
    for manifest in $(cargo metadata --no-deps --format-version 1 | jq -r '.packages[].manifest_path'); do
        cargo msrv verify --manifest-path "$manifest"
    done

# Public API changes vs. the crate's last rust/<crate>/v* tag must match the version bump.
# The baseline is the tag, not a registry, because nothing is published yet; a crate that
# was never tagged has no baseline and is skipped.
semver:
    #!/usr/bin/env bash
    set -euo pipefail
    for crate in $(cargo metadata --no-deps --format-version 1 | jq -r '.packages[].name' | sort); do
        latest=$(git tag -l "rust/$crate/v*" | sort -V | tail -1)
        if [ -z "$latest" ]; then
            echo "$crate: no baseline tag, skipped"
            continue
        fi
        cargo semver-checks check-release -p "$crate" --baseline-rev "$latest"
    done

# ---- Optional, on demand -----------------------------------------------------------

# Kani proofs of ti-xmldsig (escaping, namespace rendering, depth scan); slow, not part
# of `check`. Needs `cargo install --locked kani-verifier && cargo kani setup`.
verify-formal:
    #!/usr/bin/env bash
    set -euo pipefail
    cd ti-xmldsig
    # A long proof run must not be cut short by the Mac going to sleep.
    if command -v caffeinate >/dev/null; then caffeinate -i cargo kani; else cargo kani; fi

# Miri on the test suite (only meaningful if a crate ever allows unsafe; nightly required)
miri:
    cargo +nightly miri test --workspace

# Mutation testing for a crate; slow, run before a release of that crate
mutants crate:
    cargo mutants -p {{crate}} --in-place

# The CLI's release binary is built with symbols in target/bloat, so the normal build stays
# stripped.
# What takes the space in the CLI's release binary, per crate (top N)
bloat n="25":
    CARGO_PROFILE_RELEASE_STRIP=none CARGO_TARGET_DIR=target/bloat cargo bloat --release -p ti-cli --crates -n {{n}}

# Show the latest release tag for every crate
versions:
    #!/usr/bin/env bash
    set -euo pipefail
    for crate in $(cargo metadata --no-deps --format-version 1 | jq -r '.packages[].name' | sort); do
        latest=$(git tag -l "rust/$crate/v*" | sort -V | tail -1)
        printf '%-12s %s\n' "$crate" "${latest:-<untagged>}"
    done

# List crates with commits since their latest tag (candidates for a version bump)
changed:
    #!/usr/bin/env bash
    set -euo pipefail
    for crate in $(cargo metadata --no-deps --format-version 1 | jq -r '.packages[].name' | sort); do
        latest=$(git tag -l "rust/$crate/v*" | sort -V | tail -1)
        if [ -z "$latest" ]; then
            echo "$crate: never tagged"
        elif [ -n "$(git log --oneline "$latest"..HEAD -- "$crate")" ]; then
            echo "$crate: changed since $latest"
        fi
    done

# Tag a crate: just tag ti-pki 0.1.0 -> rust/ti-pki/v0.1.0
tag crate ver:
    git tag -a "rust/{{crate}}/v{{ver}}" -m "{{crate}} v{{ver}}"

# Push all local tags to origin
push-tags:
    git push origin --tags

# Show what would be packaged (nothing internal must appear here)
package-list crate:
    cargo package -p {{crate}} --list
