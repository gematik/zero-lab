# Pinned cargo tools (installed with `just tools`; versions are the single source of truth)
NEXTEST       := "cargo-nextest@0.9.146"
DENY          := "cargo-deny@0.20.2"
AUDIT         := "cargo-audit@0.22.2"
VET           := "cargo-vet@0.10.2"
HACK          := "cargo-hack@0.6.45"
MACHETE       := "cargo-machete@0.9.2"
SEMVER_CHECKS := "cargo-semver-checks@0.50.0"
MSRV          := "cargo-msrv@0.19.3"
MUTANTS       := "cargo-mutants@27.1.0"
RELEASE_PLZ   := "release-plz@0.3.169"
CROSS         := "cross@0.2.5"
BLOAT         := "cargo-bloat@0.12.1"

# Every crate is versioned solely by its own git tag (rust/<crate>/vX.Y.Z), bumped only
# when that crate changes. Siblings resolve each other through the `version` in
# [workspace.dependencies], which a bump must raise too (see docs/development.md).

# Display available commands
info:
    just --list

# Install the pinned tools (use cargo-binstall when available, it avoids compiling)
tools:
    #!/usr/bin/env bash
    set -euo pipefail
    for t in {{NEXTEST}} {{DENY}} {{AUDIT}} {{VET}} {{HACK}} {{MACHETE}} {{SEMVER_CHECKS}} {{MSRV}} {{MUTANTS}} {{RELEASE_PLZ}} {{CROSS}} {{BLOAT}}; do
        if command -v cargo-binstall >/dev/null; then cargo binstall -y "$t"; else cargo install --locked "$t"; fi
    done

# ---- The ti command-line tool -------------------------------------------------------

# Install `ti` into ~/.cargo/bin
install:
    cargo install --path ti-cli --locked --force

# Linux (static musl) and Windows are built through cross in Docker, macOS natively on
# a Mac; needs `just tools` and a running Docker daemon.
# Release binaries of the CLI for every distributed platform into target/dist
cli-targets:
    #!/usr/bin/env bash
    set -euo pipefail
    command -v cross >/dev/null || { echo "cross is missing: just tools" >&2; exit 1; }
    docker info >/dev/null 2>&1 || { echo "the Docker daemon is not running" >&2; exit 1; }
    meta=$(cargo metadata --no-deps --format-version 1 \
        | jq -r '.packages[] | select(.name == "ti-cli")
                 | "\(.version) \(.targets[] | select(.kind[] == "bin") | .name)"')
    read -r version bin <<< "$meta"
    targets=(x86_64-unknown-linux-musl aarch64-unknown-linux-musl x86_64-pc-windows-gnu)
    native=()
    if [[ "$(uname -s)" == Darwin ]]; then native=(aarch64-apple-darwin x86_64-apple-darwin); fi
    # cross runs a Linux toolchain inside its container; rustup refuses to install one on
    # a non-Linux host unless forced, and cross 0.2.5 does not force it.
    if [[ "$(uname -s)" != Linux ]]; then
        rustup toolchain add stable-x86_64-unknown-linux-gnu --profile minimal --force-non-host >/dev/null
    fi
    # cross's images are amd64 only; elsewhere (Apple silicon) Docker runs them emulated.
    if [[ "$(uname -m)" != x86_64 ]]; then
        export CROSS_CONTAINER_OPTS="${CROSS_CONTAINER_OPTS:-} --platform linux/amd64"
    fi
    # A release uploads everything here, so nothing from an earlier build may remain.
    rm -rf target/dist && mkdir -p target/dist
    for t in "${targets[@]}" "${native[@]}"; do
        if [[ " ${native[*]} " == *" $t "* ]]; then
            rustup target add "$t" >/dev/null
            cargo build --release --locked -p ti-cli --target "$t"
            out=target
        else
            # One target directory per cross image: the images differ in glibc, so build
            # scripts compiled in one fail to run in another.
            out="target/cross/$t"
            CARGO_TARGET_DIR="$out" cross build --release --locked -p ti-cli --target "$t"
        fi
        ext=""; [[ "$t" == *windows* ]] && ext=".exe"
        cp "$out/$t/release/$bin$ext" "target/dist/$bin-$version-$t$ext"
        echo "target/dist/$bin-$version-$t$ext"
    done

# Run the development build: just ti pki inspect card.pem
ti *ARGS:
    cargo run -q -p ti-cli -- {{ARGS}}

# ---- Releasing ti -----------------------------------------------------------------
# The binaries are attached to a GitHub release of REPO with their SHA256SUMS. GH
# replaces the gh CLI for dry runs.

REPO := "gematik/zero-lab"
# The GitHub user or organization whose homebrew-tap repository carries the formula.
TAP_OWNER := "spilikin"

# A crate's release notes from ReleaseNotes.md: those of a version, or its pending ones (just release-notes Unreleased ti-pki)
release-notes version="Unreleased" crate="ti-cli":
    #!/usr/bin/env bash
    set -euo pipefail
    notes=$(VERSION="{{version}}" CRATE="{{crate}}" perl -0777 -ne '
        my ($v, $c) = ($ENV{VERSION}, $ENV{CRATE});
        if ($v eq "Unreleased") {
            my ($u) = /^## Unreleased\n(.*?)(?=^## |\z)/ms or exit;
            my ($b) = $u =~ /^### \Q$c\E\n(.*?)(?=^### |\z)/ms or exit;
            $b =~ s/^####/###/mg;
            print $b;
        } else {
            print $1 if /^## Release \Q$c $v\E,[^\n]*\n(.*?)(?=^## |\z)/ms;
        }' ReleaseNotes.md | sed -e '/[^[:space:]]/,$!d')
    [[ -n "$notes" ]] || { echo "release-notes: no notes for {{crate}} {{version}} in ReleaseNotes.md" >&2; exit 1; }
    printf '%s\n' "$notes"

# Release ti from main: bump, check, build, commit, tag, push, GitHub release and the Homebrew formula in <tap>/homebrew-tap
release version tap=TAP_OWNER:
    #!/usr/bin/env bash
    set -euo pipefail
    GH="${GH:-gh}"
    v="{{version}}"; tag="rust/ti-cli/v$v"; tap="{{tap}}"
    die() { echo "release: $*" >&2; exit 1; }
    newer() { [[ "$1" != "$2" && "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" == "$1" ]]; }

    [[ "$v" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] || die "VERSION must be X.Y.Z, not '$v'"
    [[ "$(git branch --show-current)" == main ]] || die "releases start from main"
    [[ -z "$(git status --porcelain)" ]] || die "the working tree is not clean"
    git fetch -q origin main
    [[ "$(git rev-parse main)" == "$(git rev-parse origin/main)" ]] || die "main and origin/main differ"
    ! git rev-parse -q --verify "refs/tags/$tag" >/dev/null || die "$tag exists"
    [[ -z "$(git ls-remote --tags origin "refs/tags/$tag")" ]] || die "$tag exists on origin"
    last=$(git tag -l 'rust/ti-cli/v*' | sed 's|.*/v||' | sort -V | tail -1)
    [[ -z "$last" ]] || newer "$v" "$last" || die "$v is not above the last release $last"
    current=$(cargo metadata --no-deps --format-version 1 | jq -r '.packages[] | select(.name == "ti-cli") | .version')
    [[ "$v" == "$current" ]] || newer "$v" "$current" || die "$v is below ti-cli's version $current"
    just release-notes Unreleased >/dev/null || die "write the release notes first"
    command -v cross >/dev/null || die "cross is missing: just tools"
    docker info >/dev/null 2>&1 || die "the Docker daemon is not running"
    "$GH" auth status >/dev/null 2>&1 || die "gh is not logged in: gh auth login"

    trap 'echo "release: stopped before the commit; undo the bump with: git checkout -- ti-cli/Cargo.toml Cargo.lock ReleaseNotes.md" >&2' ERR
    if [[ "$v" != "$current" ]]; then
        perl -0pi -e 's/^version = "[^"]*"/version = "'"$v"'"/m' ti-cli/Cargo.toml
        cargo update -q -p ti-cli --offline
    fi
    # ti-cli's block leaves "Unreleased" and becomes the section of this release.
    CRATE=ti-cli HEADING="## Release ti-cli $v, $(date +%F)" perl -0777 -i -pe '
        my ($c, $h) = ($ENV{CRATE}, $ENV{HEADING});
        s{^## Unreleased\n(.*?)(?=^## |\z)}{
            my $u = $1;
            $u =~ s{^### \Q$c\E\n(.*?)(?=^### |\z)}{}ms or die "no $c under Unreleased\n";
            my $b = $1;
            $b =~ s/^####/###/mg;
            $b =~ s/\s+\z/\n/;
            $u =~ s/\s+\z/\n/;
            $u = "" unless $u =~ /\S/;
            "## Unreleased\n$u\n$h\n$b\n"
        }mse;
        s/\n+\z/\n/' ReleaseNotes.md
    just check
    just audit
    just cli-targets
    (cd target/dist && shasum -a 256 "ti-$v-"* > SHA256SUMS)
    trap - ERR

    git add ti-cli/Cargo.toml Cargo.lock ReleaseNotes.md
    git commit -q -m "ti-cli: release $v"
    just tag ti-cli "$v"

    notes=$(mktemp); trap 'rm -f "$notes"' EXIT
    {
        just release-notes "$v" ti-cli
        echo
        echo "---"
        echo
        echo "**Install** on macOS and Linux: \`brew install $tap/tap/ti\`, update with \`brew upgrade ti\`."
        echo
        echo "**Verify** a download: \`shasum -a 256 -c SHA256SUMS --ignore-missing\`"
    } > "$notes"
    echo; cat "$notes"; echo; ls -l target/dist; echo
    read -r -p "Push main and $tag, and publish? [y/N] " answer
    if [[ "$answer" != [yY] ]]; then
        echo "Not published. Undo with: git tag -d $tag && git reset --keep HEAD~1"
        exit 1
    fi

    git push --atomic origin main "$tag"
    "$GH" release create "$tag" --repo {{REPO}} --verify-tag --title "ti $v" --notes-file "$notes" target/dist/*
    just publish-brew "$tap" "$v"

# Point the ti formula in <owner>/homebrew-tap at a release (default: the newest), from its checksums
publish-brew owner=TAP_OWNER version="":
    #!/usr/bin/env bash
    set -euo pipefail
    GH="${GH:-gh}"
    die() { echo "publish-brew: $*" >&2; exit 1; }
    v="{{version}}"
    [[ -n "$v" ]] || v=$(git tag -l 'rust/ti-cli/v*' | sed 's|.*/v||' | sort -V | tail -1)
    [[ -n "$v" ]] || die "no ti release yet"
    tag="rust/ti-cli/v$v"
    work=$(mktemp -d); trap 'rm -rf "$work"' EXIT

    "$GH" release download "$tag" --repo {{REPO}} -p SHA256SUMS -D "$work"
    assets=$("$GH" release view "$tag" --repo {{REPO}} --json assets --jq '.assets[] | "\(.name) \(.url)"')
    args=(-e "s|@VERSION@|$v|g")
    for target in aarch64-apple-darwin x86_64-apple-darwin aarch64-unknown-linux-musl x86_64-unknown-linux-musl; do
        name="ti-$v-$target"
        sum=$(awk -v f="$name" '$2 == f {print $1}' "$work/SHA256SUMS")
        url=$(awk -v f="$name" '$1 == f {print $2}' <<< "$assets")
        [[ -n "$sum" && -n "$url" ]] || die "$tag has no $name"
        args+=(-e "s|@URL_$target@|$url|" -e "s|@SHA256_$target@|$sum|")
    done

    "$GH" repo clone "{{owner}}/homebrew-tap" "$work/tap" -- -q --depth 1
    mkdir -p "$work/tap/Formula"
    sed "${args[@]}" ti-cli/Formula/ti.rb > "$work/tap/Formula/ti.rb"
    ! grep -q '@[A-Z0-9_a-z-]*@' "$work/tap/Formula/ti.rb" || die "unfilled placeholders in the formula"
    git -C "$work/tap" add Formula/ti.rb
    if git -C "$work/tap" diff --cached --quiet; then
        echo "{{owner}}/homebrew-tap already has ti $v"
    else
        git -C "$work/tap" commit -q -m "ti $v"
        git -C "$work/tap" push -q
        echo "{{owner}}/homebrew-tap: ti $v. Install: brew install {{owner}}/tap/ti"
    fi

# ---- Tier 1: every PR --------------------------------------------------------------

# Everything a PR must pass, in the order that fails fastest
check: fmt clippy doc test features wasm32 core-deps nonprod-absent machete deny

# Formatting (rustfmt.toml is the source of truth)
fmt:
    cargo fmt --all -- --check

# Clippy on all targets with all features and with the defaults; warnings are errors.
# The default pass catches code that only a feature makes used (e.g. test imports).
clippy:
    cargo clippy --workspace --all-targets --all-features -- -D warnings
    cargo clippy --workspace --all-targets -- -D warnings

# Rustdoc must build warning-free (broken intra-doc links, missing docs)
doc:
    RUSTDOCFLAGS="-D warnings" cargo doc --workspace --no-deps --all-features

# Tests via nextest (parallel, per-test timeouts, better failure output) with all
# features and with the defaults, then doctests
test:
    cargo nextest run --workspace --all-features
    cargo nextest run --workspace
    cargo test --workspace --all-features --doc

# The cache, the loading layer, the reqwest transport and PKCS#12 decoding build for
# the browser
wasm32:
    cargo check -p ti-cache --target wasm32-unknown-unknown
    cargo check -p ti-connector-client --target wasm32-unknown-unknown
    cargo check -p ti-pki --target wasm32-unknown-unknown --features load,reqwest
    cargo check -p ti-pkcs12 --target wasm32-unknown-unknown

# ti-pki's and ti-connector-client's cores (everything but the optional adapter and
# algorithm features) pull in no HTTP client, TLS, executor, file watcher or brainpool
# arithmetic; cargo-deny bans are workspace-wide, so this is a tree check
core-deps:
    #!/usr/bin/env bash
    set -euo pipefail
    found=$(cargo tree -p ti-pki -e normal --prefix none --no-default-features \
            --features load,os,test-util,dangerous-nonprod \
        | grep -E '^(reqwest|tokio|hyper|notify|bp256|bp384) ' || true)
    if [ -n "$found" ]; then echo "ti-pki core depends on: $found" >&2; exit 1; fi
    echo "ti-pki core is free of HTTP clients, executors, file watchers and brainpool"
    found=$(cargo tree -p ti-connector-client -e normal --prefix none \
        | grep -E '^(reqwest|ureq|rustls|tokio|hyper|bp256|bp384|rsa) ' || true)
    if [ -n "$found" ]; then echo "ti-connector-client core depends on: $found" >&2; exit 1; fi
    echo "ti-connector-client core is free of HTTP clients, TLS, executors and brainpool"

# Without dangerous-nonprod, the compiled ti-pki must contain none of the non-prod trust
# files. Compares their bytes, not a marker string (the marker legitimately occurs in
# code and docs), and repeats with the feature on so the check cannot pass vacuously.
nonprod-absent:
    #!/usr/bin/env bash
    set -euo pipefail
    files=(ti-pki/src/anchors/GEM.RCA7-TEST-ONLY.der ti-pki/src/anchors/GEM.RCA8-TEST-ONLY.der ti-pki/src/roots-nonprod.json)
    rlib() {
        cargo build -p ti-pki --message-format=json "$@" 2>/dev/null \
            | jq -r 'select(.reason == "compiler-artifact" and .target.name == "ti_pki") | .filenames[] | select(endswith(".rlib"))'
    }
    # Exact byte-substring search: does file $2 occur inside file $1?
    contains() { perl -0777 -e 'open(my $h, "<:raw", $ARGV[0]) or die; open(my $n, "<:raw", $ARGV[1]) or die; exit(index(<$h>, <$n>) < 0)' "$1" "$2"; }
    lib=$(rlib)
    for f in "${files[@]}"; do
        if contains "$lib" "$f"; then echo "non-prod material in $lib: $f" >&2; exit 1; fi
    done
    lib=$(rlib --features dangerous-nonprod)
    for f in "${files[@]}"; do
        contains "$lib" "$f" || { echo "check is blind: $f not found with dangerous-nonprod" >&2; exit 1; }
    done
    echo "no non-prod trust material without dangerous-nonprod"

# Live tests against gematik's endpoints: roots.json and TSL of every environment,
# OCSP at real responders (network and curl required; not part of `check`)
real-world:
    cargo test -p ti-pki --features load,os,dangerous-nonprod --test real_world -- --ignored --nocapture --test-threads 1

# Regenerate the Konnektor bindings in ti-connector-client/src/api from the
# wsdl2openapi checkout next to this repository (or WSDL2OPENAPI_DIR)
generate-connector:
    #!/usr/bin/env bash
    set -euo pipefail
    gen="${WSDL2OPENAPI_DIR:-../../wsdl2openapi}/generator-rust"
    out="$PWD/ti-connector-client/src/api"
    rm -rf "$out"
    (cd "$gen" && cargo run -q -- --file ../Konnektor-OPB6.json --naming naming-kon.json \
        --module-root crate::api --select "$OLDPWD/ti-connector-client/api.select.json" --output "$out")
    cargo fmt -p ti-connector-client
    echo "generated by wsdl2openapi $(git -C "$gen" rev-parse --short HEAD)"

# Regenerate the OpenSSL test PKI in ti-pki/tests/pki (fresh keys, same topology)
test-pki:
    ti-pki/tests/pki/generate.sh

# Every feature combination must compile (catches feature-gated breakage)
features:
    cargo hack check --workspace --feature-powerset --no-dev-deps

# Unused dependencies in Cargo.toml
machete:
    cargo machete --with-metadata

# Licences, bans, advisories, sources (deny.toml)
deny:
    cargo deny check

# ---- Tier 2: before tagging, and periodically on main ------------------------------

# Supply-chain and API tier
audit: advisories vet msrv semver

# RustSec advisories against Cargo.lock (overlaps deny's advisories check; kept separately
# because cargo-audit also reports yanked crates and can `cargo audit fix`)
advisories:
    cargo audit --deny warnings

# Supply-chain review status of every dependency (config in supply-chain/)
vet:
    cargo vet --locked

# Dependencies that cargo vet still needs a review for, most impactful first
vet-suggest:
    cargo vet suggest

# rust-version in Cargo.toml actually builds every crate (cargo-msrv has no --workspace)
msrv:
    #!/usr/bin/env bash
    set -euo pipefail
    for manifest in $(cargo metadata --no-deps --format-version 1 | jq -r '.packages[].manifest_path'); do
        cargo msrv verify --manifest-path "$manifest"
    done

# Public API changes vs. the crate's last rust/<crate>/v* tag must match the version bump.
# The baseline is the tag, not a registry, because nothing is published yet; a crate that
# was never tagged has no baseline and is skipped.
semver:
    #!/usr/bin/env bash
    set -euo pipefail
    for crate in $(cargo metadata --no-deps --format-version 1 | jq -r '.packages[].name' | sort); do
        latest=$(git tag -l "rust/$crate/v*" | sort -V | tail -1)
        if [ -z "$latest" ]; then
            echo "$crate: no baseline tag, skipped"
            continue
        fi
        cargo semver-checks check-release -p "$crate" --baseline-rev "$latest"
    done

# ---- Optional, on demand -----------------------------------------------------------

# Miri on the test suite (only meaningful if a crate ever allows unsafe; nightly required)
miri:
    cargo +nightly miri test --workspace

# Mutation testing for a crate; slow, run before a release of that crate
mutants crate:
    cargo mutants -p {{crate}} --in-place

# The CLI's release binary is built with symbols in target/bloat, so the normal build stays
# stripped.
# What takes the space in the CLI's release binary, per crate (top N)
bloat n="25":
    CARGO_PROFILE_RELEASE_STRIP=none CARGO_TARGET_DIR=target/bloat cargo bloat --release -p ti-cli --crates -n {{n}}

# Show the latest release tag for every crate
versions:
    #!/usr/bin/env bash
    set -euo pipefail
    for crate in $(cargo metadata --no-deps --format-version 1 | jq -r '.packages[].name' | sort); do
        latest=$(git tag -l "rust/$crate/v*" | sort -V | tail -1)
        printf '%-12s %s\n' "$crate" "${latest:-<untagged>}"
    done

# List crates with commits since their latest tag (candidates for a version bump)
changed:
    #!/usr/bin/env bash
    set -euo pipefail
    for crate in $(cargo metadata --no-deps --format-version 1 | jq -r '.packages[].name' | sort); do
        latest=$(git tag -l "rust/$crate/v*" | sort -V | tail -1)
        if [ -z "$latest" ]; then
            echo "$crate: never tagged"
        elif [ -n "$(git log --oneline "$latest"..HEAD -- "$crate")" ]; then
            echo "$crate: changed since $latest"
        fi
    done

# Tag a crate: just tag ti-pki 0.1.0 -> rust/ti-pki/v0.1.0
tag crate ver:
    git tag -a "rust/{{crate}}/v{{ver}}" -m "{{crate}} v{{ver}}"

# Push all local tags to origin
push-tags:
    git push origin --tags

# Show what would be packaged (nothing internal must appear here)
package-list crate:
    cargo package -p {{crate}} --list
