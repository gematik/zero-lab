# Fuzz every ti-connector-client parser for `seconds` each (design time; nightly and
# cargo-fuzz). Corpora start from ti-connector-client/fuzz/seeds and grow in
# ti-connector-client/fuzz/corpus (not committed).
fuzz-ti-connector-client seconds="30":
    #!/usr/bin/env bash
    set -euo pipefail
    cd ti-connector-client/fuzz
    for target in dotkon sds soap; do
