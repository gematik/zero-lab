        seeds=../tests/fixtures
        [ "$target" != dotkon ] || seeds=seeds/dotkon
        mkdir -p "corpus/$target"
        cargo +{{JWZ_NIGHTLY}} fuzz run -O "$target" "corpus/$target" "$seeds" -- \
            -max_total_time={{seconds}} -max_len=65536 -timeout=30 -print_final_stats=1 2>&1 \
            | grep -E "^(stat::number_of_executed_units|Done|==|SUMMARY)" || true
