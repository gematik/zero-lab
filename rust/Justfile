# Kani proofs of jwz (src/proofs.rs; design time, stamped as verification/stamps/kani.toml)
verify-formal-jwz:
    #!/usr/bin/env bash
    set -euo pipefail
    cd jwz
    if command -v caffeinate >/dev/null; then run=(caffeinate -i); else run=(); fi
    "${run[@]}" cargo kani --features std,jws,jwe,jwt,crypto-rustcrypto

# hax extraction of jwz's Concat KDF core to F* and its proof against SP 800-56A §5.8.1
# (design time: cargo-hax and hax-engine in the opam switch HAX_SWITCH, hax's proof
# libraries in HAX_HOME, F* in FSTAR_HOME; stamped as verification/stamps/hax.toml)
verify-hax-jwz:
    #!/usr/bin/env bash
    set -euo pipefail
    cd jwz
    eval "$(opam env --switch="${HAX_SWITCH:-hax-0.4.2}")"
    # hax's toolchain is older than the workspace's rust-version; the KDF core needs nothing newer.
    cargo hax -C --no-default-features --features jwe --ignore-rust-version \; \
        into -i '-** +jwz::jwe::ecdh::kdf::**' --output-dir verification/hax/extraction fstar
    make -C verification/hax verify

# Re-run the design-time checks whose inputs changed since their stamp (all with --all)
# and rewrite the stamps; `cargo test -p jwz --test stamps` fails on a stale one
jwz-recheck *flags:
    #!/usr/bin/env bash
    set -euo pipefail
    cd jwz
    all=false; [ "{{flags}}" = "--all" ] && all=true
    mkdir -p verification/stamps
    # recheck <name> <recipe> <tool version> <input>...
    recheck() {
        local name=$1 recipe=$2 tool=$3; shift 3
        local file="verification/stamps/$name.toml" fresh=true
        if $all || [ ! -f "$file" ] || [ "$(grep -c '^"' "$file")" != "$#" ]; then fresh=false; fi
        for input in "$@"; do
            local hash; hash=$(shasum -a 256 "$input" | cut -d' ' -f1)
            grep -qxF "\"$input\" = \"$hash\"" "$file" 2>/dev/null || fresh=false
        done
        if $fresh; then echo "$name: fresh"; return; fi
        echo "$name: running just $recipe"
        (cd .. && just "$recipe")
        {
            echo "# Written by \`just jwz-recheck\`; checked by \`cargo test -p jwz --test stamps\`."
            echo "check = \"$name\""
            echo "command = \"just $recipe\""
            echo "tool = \"$tool\""
            echo "outcome = \"passed\""
            echo
            echo "[inputs]"
            for input in "$@"; do
                echo "\"$input\" = \"$(shasum -a 256 "$input" | cut -d' ' -f1)\""
            done
        } > "$file"
        echo "$name: passed, stamp written"
    }
    recheck kani verify-formal-jwz "$(cargo kani --version | head -1)" \
        src/proofs.rs src/b64.rs src/compact.rs src/profile/mod.rs src/jwe/ecdh.rs
    hax_version=$(eval "$(opam env --switch="${HAX_SWITCH:-hax-0.4.2}")" && cargo hax --version | sed -n 's/^version=//p')
    recheck hax verify-hax-jwz "hax $hax_version, $(make -s -C verification/hax version)" \
        src/jwe/ecdh.rs verification/hax/Makefile verification/hax/Jwz.Kdf.Spec.fst \
        $(ls verification/hax/extraction/*.fst)
    shell=$(ls -d "{{JWZ_CHROME_DIR}}"/chrome-headless-shell/*/chrome-headless-shell-*/chrome-headless-shell | sort -V | tail -1)
    # What differs in the browser: the backend and its random source, the clock, the
    # dependency versions and features, brainpool arithmetic; and the tests themselves.
    recheck browser jwz-browser "$("$shell" --version), $(wasm-bindgen-test-runner --version)" \
        tests/browser.rs src/crypto/rustcrypto.rs src/jwt.rs Cargo.toml ../Cargo.toml \
        ../ti-jwz/tests/browser.rs ../ti-jwz/Cargo.toml $(ls ../ti-jwz/src/brainpool/*.rs) \
        $(ls ../ti-jwz/tests/data/interop/{keys,jwz,go,python}.json)

# Miri on the test suite (only meaningful if a crate ever allows unsafe; nightly required)
miri:
    cargo +nightly miri test --workspace

# Mutation testing for a crate; slow, run before a release of that crate
mutants crate:
    cargo mutants -p {{crate}} --in-place {{ if crate == "jwz" { "--features " + JWZ_FEATURES } else { "--all-features" } }}

# `just release` checks the score; commit mutation-scores.toml afterwards.
# Measure a crate's mutation score on the committed tree and record it in mutation-scores.toml
mutants-record crate:
    #!/usr/bin/env bash
    set -euo pipefail
    [[ -z "$(git status --porcelain -- {{crate}})" ]] || { echo "mutants-record: {{crate}} has uncommitted changes" >&2; exit 1; }
    out=target/mutants/{{crate}}
    mkdir -p "$out"
    # A missed mutant makes cargo-mutants exit non-zero; the score is the verdict here.
    cargo mutants -p {{crate}} --in-place --output "$out" {{ if crate == "jwz" { "--features " + JWZ_FEATURES } else { "--all-features" } }} || true
    python3 -I scripts/mutation.py record {{crate}} "$out/mutants.out/outcomes.json"

# Each score must exist, belong to the crate as it is now, and reach the crate's threshold.
# Check the recorded mutation scores of crates about to be released
mutants-gate +crates:
    python3 -I scripts/mutation.py gate {{crates}}

# Default: every workspace crate; the HTML report goes to target/coverage/html.
# Line coverage per crate and the cited requirements whose code no test runs
coverage *crates:
    #!/usr/bin/env bash
    set -euo pipefail
    crates=({{crates}})
    if [[ ${#crates[@]} -eq 0 ]]; then
        crates=($(cargo metadata --no-deps --format-version 1 \
            | python3 -I -c 'import json, sys; print(" ".join(p["name"] for p in json.load(sys.stdin)["packages"]))'))
    fi
    mkdir -p target/coverage
    cargo llvm-cov clean --workspace
    for c in "${crates[@]}"; do
        if [[ "$c" == jwz ]]; then features=(--features {{JWZ_FEATURES}}); else features=(--all-features); fi
        cargo llvm-cov nextest -p "$c" "${features[@]}" --no-report
    done
    cargo llvm-cov report --html --output-dir target/coverage
    cargo llvm-cov report --lcov --output-path target/coverage/lcov.info
    python3 -I scripts/coverage_gaps.py target/coverage/lcov.info "${crates[@]}"
    echo "HTML report: target/coverage/html/index.html"

# The CLI's release binary is built with symbols in target/bloat, so the normal build stays
# stripped.
# What takes the space in the CLI's release binary, per crate (top N)
bloat n="25":
    CARGO_PROFILE_RELEASE_STRIP=none CARGO_TARGET_DIR=target/bloat cargo bloat --release -p ti-cli --crates -n {{n}}

# Every change to a workspace crate leaves its old test binaries behind in
# target/debug/deps and grows the incremental caches of every profile and
# target, so target/ only grows. This drops the workspace crates' artefacts,
# every incremental cache (also of the fuzz workspaces) and keeps the
# third-party builds and target/dist; the next build recompiles only the
# workspace.
#
# Free disk space, keeping the third-party builds.
free:
    #!/usr/bin/env bash
    set -eu -o pipefail
    before=$(df -k . | awk 'NR==2 {print $4}')
    packages=$(cargo metadata --no-deps --format-version 1 \
        | python3 -I -c 'import json, sys; print(" ".join("-p " + p["name"] for p in json.load(sys.stdin)["packages"]))')
    cargo clean --quiet $packages
    cargo clean --quiet --release $packages
    for dir in target */fuzz/target; do
        if [ -d "$dir" ]; then
            find "$dir" -maxdepth 4 -type d -name incremental -prune -exec rm -rf {} +
        fi
    done
    after=$(df -k . | awk 'NR==2 {print $4}')
    echo "freed $(( (after - before) / 1024 / 1024 )) GiB, $(df -h . | awk 'NR==2 {print $4}') available"

# The whole target folder with target/dist, the fuzz workspaces' target
# folders and the Python interop venv. Fuzz corpora stay. The next build starts
# from scratch.
#
# Remove everything a build made.
clean:
    #!/usr/bin/env bash
    set -eu -o pipefail
    before=$(df -k . | awk 'NR==2 {print $4}')
    cargo clean
    for dir in */fuzz/target ti-jwz/interop/python/.venv; do
        if [ -d "$dir" ]; then
            echo "removing $dir"
            rm -rf "$dir"
        fi
    done
    after=$(df -k . | awk 'NR==2 {print $4}')
    echo "freed $(( (after - before) / 1024 / 1024 )) GiB, $(df -h . | awk 'NR==2 {print $4}') available"

# Show the latest release tag for every crate
versions:
    #!/usr/bin/env bash
    set -euo pipefail
    for crate in $(cargo metadata --no-deps --format-version 1 | jq -r '.packages[].name' | sort); do
        latest=$(git tag -l "rust/$crate/v*" | sort -V | tail -1)
        printf '%-12s %s\n' "$crate" "${latest:-<untagged>}"
    done

# List crates with commits since their latest tag (candidates for a version bump)
changed:
    #!/usr/bin/env bash
    set -euo pipefail
    for crate in $(cargo metadata --no-deps --format-version 1 | jq -r '.packages[].name' | sort); do
        latest=$(git tag -l "rust/$crate/v*" | sort -V | tail -1)
        if [ -z "$latest" ]; then
            echo "$crate: never tagged"
        elif [ -n "$(git log --oneline "$latest"..HEAD -- "$crate")" ]; then
            echo "$crate: changed since $latest"
        fi
    done

# Tag a crate: just tag ti-pki 0.1.0 -> rust/ti-pki/v0.1.0
tag crate ver:
    git tag -a "rust/{{crate}}/v{{ver}}" -m "{{crate}} v{{ver}}"

# Push all local tags to origin
push-tags:
    git push origin --tags

# Show what would be packaged (nothing internal must appear here)
package-list crate:
    cargo package -p {{crate}} --list
