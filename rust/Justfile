    done

# Fuzz ti-pkcs12's decoder for `seconds` (design time; nightly, cargo-fuzz and Go). The
# seeds are a fresh spec/pkcs12 conformance corpus and its vendor files, each as a
# length byte, the password and the file; corpora grow in ti-pkcs12/fuzz/corpus (not
# committed).
fuzz-ti-pkcs12 seconds="30":
    #!/usr/bin/env bash
    set -euo pipefail
    spec="$PWD/../spec/pkcs12"
    cd ti-pkcs12/fuzz
    work=$(mktemp -d)
    trap 'rm -rf "$work"' EXIT
    (cd "$spec/tool" && go build -o "$work/p12conformance" .)
    "$work/p12conformance" generate -manifest "$spec/testdata/manifest.json" -out "$work/corpus" >/dev/null
    cp "$spec"/testdata/vendor/*.p12 "$spec"/testdata/vendor/*-password.txt "$work/corpus/"
    rm -rf seeds/decode && mkdir -p seeds/decode corpus/decode
    for file in "$work"/corpus/*.p12; do
        name=$(basename "$file" .p12)
        password_file="$work/corpus/${name%.*}.password"
        [ -f "$password_file" ] || password_file="$work/corpus/$name-password.txt"
        password=$(tr -d '\n' < "$password_file")
        length=$(printf %s "$password" | wc -c | tr -d ' ')
        { printf "\\$(printf %03o "$length")"; printf %s "$password"; cat "$file"; } > "seeds/decode/$name"
    done
    cargo +{{JWZ_NIGHTLY}} fuzz run -O decode corpus/decode seeds/decode -- \
        -max_total_time={{seconds}} -max_len=65536 -timeout=30 -malloc_limit_mb=256 \
        -print_final_stats=1 2>&1 \
        | grep -E "^(stat::number_of_executed_units|Done|==|SUMMARY)" || true
    [ -z "$(ls -A artifacts/decode 2>/dev/null)" ] || { echo "decode: crash in artifacts/decode" >&2; exit 1; }

# Chrome for Testing (headless shell and its chromedriver) for `jwz-browser`; override
# the location with JWZ_CHROME_DIR=<dir>
JWZ_CHROME_DIR := env_var_or_default("JWZ_CHROME_DIR", env_var("HOME") / "Development/tools/chrome")

# Download Chrome for Testing's current stable headless shell and chromedriver (node required)
jwz-browser-tools:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p "{{JWZ_CHROME_DIR}}"
    cd "{{JWZ_CHROME_DIR}}"
    # A NODE_OPTIONS preload from the calling shell must not leak into npx.
    env -u NODE_OPTIONS npx -y @puppeteer/browsers install chrome-headless-shell@stable
    env -u NODE_OPTIONS npx -y @puppeteer/browsers install chromedriver@stable

# Design time, stamped as jwz/verification/stamps/browser.toml.
# The browser tests of jwz and ti-jwz's brainpool, wasm32-unknown-unknown in headless Chrome
jwz-browser:
    #!/usr/bin/env bash
    set -euo pipefail
    want=$(sed -n 's/^wasm-bindgen = "=\(.*\)"$/\1/p' ti-wasm/Cargo.toml)
    have=$(wasm-bindgen-test-runner --version 2>/dev/null | awk '{print $2}') || true
    [[ "$have" == "$want" ]] || { echo "jwz-browser: wasm-bindgen-cli $want needed, found '${have:-none}': just tools" >&2; exit 1; }
    dir="{{JWZ_CHROME_DIR}}"
    shell=$(ls -d "$dir"/chrome-headless-shell/*/chrome-headless-shell-*/chrome-headless-shell 2>/dev/null | sort -V | tail -1) || true
    [[ -n "$shell" ]] || { echo "jwz-browser: no headless shell in $dir: just jwz-browser-tools" >&2; exit 1; }
    # chromedriver must be the shell's version.
    version=$("$shell" --version | awk '{print $NF}')
    driver=$(ls -d "$dir"/chromedriver/*-"$version"/chromedriver-*/chromedriver 2>/dev/null | tail -1) || true
    [[ -n "$driver" ]] || { echo "jwz-browser: no chromedriver $version in $dir: just jwz-browser-tools" >&2; exit 1; }
    mkdir -p target/jwz-browser
    printf '{"goog:chromeOptions":{"binary":"%s"}}\n' "$shell" > target/jwz-browser/webdriver.json
    WASM_BINDGEN_TEST_WEBDRIVER_JSON="$PWD/target/jwz-browser/webdriver.json" CHROMEDRIVER="$driver" \
        CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUNNER=wasm-bindgen-test-runner \
        cargo test --locked --target wasm32-unknown-unknown -p jwz -p ti-jwz --features ti-jwz/legacy --test browser

# rustls brings ring into ti-cli and ti-connector-client for TLS, so this is a tree check
# for the jwz crates rather than a deny ban (ADR 0001, principle 8).
# No openssl, ring, aws-lc or cryptoki under jwz or ti-jwz
jwz-backends:
    #!/usr/bin/env bash
    set -euo pipefail
    for crate in jwz ti-jwz; do
        found=$(cargo tree -p "$crate" -e normal --prefix none --all-features \
            | grep -E '^(openssl|openssl-sys|ring|aws-lc-rs|aws-lc-sys|cryptoki) ' || true)
        if [ -n "$found" ]; then echo "$crate depends on: $found" >&2; exit 1; fi
    done
    echo "jwz and ti-jwz are free of openssl, ring, aws-lc and cryptoki"

# jwz's `rsa` feature refuses to build until RSA crypto exists (milestone 1)
jwz-rsa-guard:
    #!/usr/bin/env bash
    set -euo pipefail
    if out=$(cargo check -q -p jwz --features rsa 2>&1); then
        echo "jwz builds with the rsa feature; the guard is gone" >&2; exit 1
    fi
    grep -q "rsa: not yet implemented" <<<"$out" || { echo "jwz --features rsa failed for another reason:" >&2; echo "$out" >&2; exit 1; }
    echo "jwz refuses the rsa feature"

# New components must not carry brainpool (ADR 0001); ti-jwz with `legacy` fails.
# No bp256 or bp384 in CRATE's tree with its default features
brainpool-absent crate:
    #!/usr/bin/env bash
    set -euo pipefail
    found=$(cargo tree -p {{crate}} -e normal --prefix none | grep -E '^(bp256|bp384) ' || true)
    if [ -n "$found" ]; then echo "{{crate}} depends on brainpool: $found" >&2; exit 1; fi
    echo "{{crate}} is free of brainpool"

