{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "connector describe card",
  "description": "One card.",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1,
      "description": "The JSON contract version; fields are only added within it."
    },
    "card": {
      "$ref": "#/$defs/card"
    },
    "telematik_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "The Telematik-ID in the card's ECC C.AUT, for an HBA or SMC-B; null for other cards or when C.AUT cannot be read."
    },
    "pins": {
      "type": "array",
      "description": "The card type's user PINs (PIN.SMC for an SMC-B, PIN.CH and PIN.QES for an HBA, none for an SMC-KT): whether one must be entered before signing.",
      "items": {
        "$ref": "#/$defs/pin"
      }
    }
  },
  "required": [
    "schema",
    "card",
    "telematik_id",
    "pins"
  ],
  "additionalProperties": false,
  "$defs": {
    "card": {
      "type": "object",
      "properties": {
        "handle": {
          "type": "string"
        },
        "card_type": {
          "type": "string",
          "description": "e.g. SMC-B, HBA, EGK, SMC-KT"
        },
        "iccsn": {
          "type": [
            "string",
            "null"
          ]
        },
        "terminal": {
          "type": "string",
          "description": "The card terminal's CtId."
        },
        "slot": {
          "type": "integer"
        },
        "holder": {
          "type": [
            "string",
            "null"
          ]
        },
        "kvnr": {
          "type": [
            "string",
            "null"
          ]
        },
        "inserted": {
          "type": "string"
        },
        "certificate_expiration": {
          "type": [
            "string",
            "null"
          ]
        },
        "cos_version": {
          "type": [
            "string",
            "null"
          ],
          "description": "major.minor.revision"
        },
        "object_system_version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "handle",
        "card_type",
        "iccsn",
        "terminal",
        "slot",
        "holder",
        "kvnr",
        "inserted",
        "certificate_expiration",
        "cos_version",
        "object_system_version"
      ],
      "additionalProperties": false
    },
    "pin": {
      "type": "object",
      "properties": {
        "pin": {
          "enum": [
            "PIN.SMC",
            "PIN.CH",
            "PIN.QES"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "VERIFIED",
            "VERIFIABLE",
            "TRANSPORT_PIN",
            "EMPTY_PIN",
            "BLOCKED",
            "DISABLED",
            null
          ],
          "description": "The Konnektor's PinStatus (CardService GetPinStatus); null when the query failed or the Konnektor named none."
        },
        "left_tries": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Tries left before the PIN is blocked, if the Konnektor says."
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why the status could not be read."
        }
      },
      "required": [
        "pin",
        "status",
        "left_tries",
        "error"
      ],
      "additionalProperties": false
    }
  }
}
