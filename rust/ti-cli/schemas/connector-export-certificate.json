{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "connector export certificate",
  "description": "A card's certificates saved; with --format json and without -o the report carries them. Without --format json and -o the PEM (or DER) itself goes to stdout.",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1,
      "description": "The JSON contract version; fields are only added within it."
    },
    "card": {
      "$ref": "#/$defs/card"
    },
    "certificates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cert_ref": {
            "enum": [
              "C.AUT",
              "C.ENC",
              "C.SIG",
              "C.QES"
            ]
          },
          "crypt": {
            "enum": [
              "ECC",
              "RSA"
            ]
          },
          "subject": {
            "type": "string"
          },
          "pem": {
            "type": "string"
          }
        },
        "required": [
          "cert_ref",
          "crypt",
          "subject",
          "pem"
        ],
        "additionalProperties": false
      }
    },
    "output": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema",
    "card",
    "certificates",
    "output"
  ],
  "additionalProperties": false,
  "$defs": {
    "card": {
      "type": "object",
      "properties": {
        "handle": {
          "type": "string"
        },
        "card_type": {
          "type": "string",
          "description": "e.g. SMC-B, HBA, EGK, SMC-KT"
        },
        "iccsn": {
          "type": [
            "string",
            "null"
          ]
        },
        "terminal": {
          "type": "string",
          "description": "The card terminal's CtId."
        },
        "slot": {
          "type": "integer"
        },
        "holder": {
          "type": [
            "string",
            "null"
          ]
        },
        "kvnr": {
          "type": [
            "string",
            "null"
          ]
        },
        "inserted": {
          "type": "string"
        },
        "certificate_expiration": {
          "type": [
            "string",
            "null"
          ]
        },
        "cos_version": {
          "type": [
            "string",
            "null"
          ],
          "description": "major.minor.revision"
        },
        "object_system_version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "handle",
        "card_type",
        "iccsn",
        "terminal",
        "slot",
        "holder",
        "kvnr",
        "inserted",
        "certificate_expiration",
        "cos_version",
        "object_system_version"
      ],
      "additionalProperties": false
    }
  }
}
