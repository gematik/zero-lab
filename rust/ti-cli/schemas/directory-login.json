{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "directory login",
  "description": "A FHIR-Directory access token from one of its Auth-Service endpoints: owner by card through the IDP-Dienst, owner with a TI-Messenger RegService-OpenID-Token, or holder, service and ti-provider with client credentials at the directory's Keycloak. One document for every path; what does not apply is null.",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1,
      "description": "The JSON contract version; fields are only added within it."
    },
    "endpoint": {
      "enum": [
        "owner",
        "holder",
        "service",
        "ti-provider"
      ],
      "description": "The Auth-Service endpoint that issued the token"
    },
    "method": {
      "enum": [
        "card",
        "regservice",
        "client_credentials"
      ],
      "description": "How the token was obtained"
    },
    "access_token": {
      "type": "string",
      "description": "The directory's access token (an ES256 JWT), for Authorization: Bearer"
    },
    "token_type": {
      "type": "string",
      "description": "Bearer"
    },
    "expires_in": {
      "type": "integer",
      "description": "Seconds of validity, as the directory announced (24 hours by specification)"
    },
    "expires_at": {
      "type": "integer",
      "description": "When the token expires, seconds since the epoch: the local clock plus expires_in"
    },
    "token": {
      "type": "object",
      "description": "The token's payload, decoded for the record and not verified: it came from the directory over TLS. Members the token lacks are null or empty.",
      "properties": {
        "iss": {
          "type": [
            "string",
            "null"
          ],
          "description": "The directory's owner-authenticate URL"
        },
        "sub": {
          "type": [
            "string",
            "null"
          ],
          "description": "The Telematik-ID"
        },
        "aud": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The directory endpoints the token is for"
        },
        "scope": {
          "type": [
            "string",
            "null"
          ],
          "description": "owner:read owner:write search:read …"
        },
        "iat": {
          "type": [
            "integer",
            "null"
          ]
        },
        "exp": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "iss",
        "sub",
        "aud",
        "scope",
        "iat",
        "exp"
      ],
      "additionalProperties": false
    },
    "directory": {
      "type": "object",
      "properties": {
        "base_url": {
          "type": "string"
        },
        "endpoint_url": {
          "type": "string",
          "description": "The endpoint that issued the token"
        },
        "authorization_url": {
          "type": [
            "string",
            "null"
          ],
          "description": "The IDP-Dienst authorization URL the directory sent the card to; null without a card"
        }
      },
      "required": [
        "base_url",
        "endpoint_url",
        "authorization_url"
      ],
      "additionalProperties": false
    },
    "idp": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "base_url": {
              "type": "string"
            },
            "issuer": {
              "type": "string"
            },
            "certificates": {
              "type": "array",
              "description": "The IDP's certificates: the discovery document's signer and PuK_IDP_SIG's, checked against the TSL with the idpd-sig profile and OCSP unless --idp-unverified",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "enum": [
                      "puk_disc_sig",
                      "puk_idp_sig"
                    ]
                  },
                  "subject": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string"
                  },
                  "verified": {
                    "type": "boolean",
                    "description": "Valid for an IDP-Dienst in the environment's TSL; false only with --idp-unverified"
                  }
                },
                "required": [
                  "key",
                  "subject",
                  "sha256",
                  "verified"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "base_url",
            "issuer",
            "certificates"
          ],
          "additionalProperties": false
        }
      ],
      "description": "The IDP-Dienst a card answered; null for the other methods"
    },
    "identity": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "subject": {
              "type": "string"
            },
            "telematik_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "subject",
            "telematik_id"
          ],
          "additionalProperties": false
        }
      ],
      "description": "The card identity; null without one"
    },
    "challenge": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "description": "Claims of the IDP's challenge, for the record; client_id is the directory's and opaque",
          "properties": {
            "client_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "scope": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "client_id",
            "scope"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Claims of the IDP's challenge; null without a card"
    },
    "client_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "The client ID of client credentials; null for the owner methods"
    },
    "warnings": {
      "type": "array",
      "items": {
        "enum": [
          "idp_certificates_unverified"
        ]
      },
      "description": "What was not proven: idp_certificates_unverified when the IDP's certificates were not checked (--idp-unverified)"
    }
  },
  "required": [
    "schema",
    "endpoint",
    "method",
    "access_token",
    "token_type",
    "expires_in",
    "expires_at",
    "token",
    "directory",
    "idp",
    "identity",
    "challenge",
    "client_id",
    "warnings"
  ],
  "additionalProperties": false
}
