{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "error",
  "description": "Any failure with --format json, on stderr; the exit code tells the class.",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1,
      "description": "The JSON contract version; fields are only added within it."
    },
    "error": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "description": "Stable snake_case kind"
        },
        "message": {
          "type": "string"
        },
        "hint": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "message",
        "hint"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "error"
  ],
  "additionalProperties": false
}
