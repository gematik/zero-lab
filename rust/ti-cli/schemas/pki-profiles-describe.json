{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pki profiles describe",
  "description": "What a profile requires of each type it accepts.",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1,
      "description": "The JSON contract version; fields are only added within it."
    },
    "profile": {
      "$ref": "#/$defs/profile"
    },
    "types": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "certificate_type": {
            "type": "string"
          },
          "key_usage": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "All required"
          },
          "extended_key_usage": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "One of these"
          },
          "policies": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/oid"
            },
            "description": "All required"
          },
          "role_oids": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/oid"
            },
            "description": "One of these; empty for none"
          }
        },
        "required": [
          "certificate_type",
          "key_usage",
          "extended_key_usage",
          "policies",
          "role_oids"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "profile",
    "types"
  ],
  "additionalProperties": false,
  "$defs": {
    "oid": {
      "type": "object",
      "properties": {
        "oid": {
          "type": "string",
          "description": "Dotted form"
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "description": "gemSpec_OID description, where the TI defines one"
        }
      },
      "required": [
        "oid",
        "name"
      ],
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "revocation": {
          "enum": [
            "hard-fail",
            "soft-fail",
            "disabled"
          ]
        },
        "accepts_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "default_for": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_role_oids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/oid"
          }
        }
      },
      "required": [
        "name",
        "description",
        "revocation",
        "accepts_types",
        "default_for",
        "required_role_oids"
      ],
      "additionalProperties": false
    }
  }
}
