{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pki roots list",
  "description": "The roots an environment trusts.",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1,
      "description": "The JSON contract version; fields are only added within it."
    },
    "environment": {
      "enum": [
        "prod",
        "ref",
        "test",
        "dev"
      ]
    },
    "trust": {
      "$ref": "#/$defs/trust"
    },
    "insecure_transport": {
      "type": "boolean"
    },
    "roots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "common_name": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "not_before": {
            "type": "string",
            "format": "date-time",
            "description": "RFC 3339, UTC"
          },
          "not_after": {
            "type": "string",
            "format": "date-time",
            "description": "RFC 3339, UTC"
          },
          "validity": {
            "enum": [
              "valid",
              "expired",
              "not_yet_valid"
            ]
          },
          "anchor": {
            "type": "boolean",
            "description": "The embedded anchor the walk started from"
          },
          "key": {
            "type": "string",
            "description": "The key, e.g. ECDSA brainpoolP256r1."
          },
          "sha256": {
            "type": "string"
          },
          "pem": {
            "type": "string",
            "description": "The certificate as PEM"
          }
        },
        "required": [
          "common_name",
          "subject",
          "not_before",
          "not_after",
          "validity",
          "anchor",
          "key",
          "sha256",
          "pem"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "environment",
    "trust",
    "insecure_transport",
    "roots"
  ],
  "additionalProperties": false,
  "$defs": {
    "trust": {
      "type": "object",
      "properties": {
        "source": {
          "enum": [
            "http",
            "cache",
            "file",
            "bundle",
            "embedded"
          ],
          "description": "Where roots.json and the TSL came from; trust never depends on it"
        },
        "fetched_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "When downloaded or last confirmed; null when embedded"
        },
        "tsl_next_update": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "RFC 3339, UTC"
        },
        "roots": {
          "type": "integer",
          "minimum": 0,
          "description": "Roots reached from the embedded anchor"
        },
        "intermediates": {
          "type": "integer",
          "minimum": 0,
          "description": "TSL CAs a verified root signed"
        },
        "note": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why the material is less than the environment's full set"
        },
        "tsl_warnings": {
          "type": "array",
          "items": {
            "enum": [
              "no_ocsp_check",
              "validity_warning_1",
              "tsl_anchor_announced"
            ]
          },
          "description": "Warnings about the TSL: no_ocsp_check when its signer's OCSP status was not queried (offline, --at), validity_warning_1 past NextUpdate within the grace period, tsl_anchor_announced when it announces a TSL signer CA this tool does not know yet."
        },
        "tsl": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "sequence_number": {
                  "type": "integer"
                },
                "signer": {
                  "type": "object",
                  "properties": {
                    "common_name": {
                      "type": "string"
                    },
                    "not_after": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "common_name",
                    "not_after"
                  ],
                  "additionalProperties": false
                },
                "signer_ocsp": {
                  "enum": [
                    "good",
                    null
                  ],
                  "description": "The signer's OCSP status when it was queried; null offline or with --at"
                },
                "tsl_signer_ca": {
                  "type": "object",
                  "properties": {
                    "common_name": {
                      "type": "string"
                    },
                    "not_after": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "common_name",
                    "not_after"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "sequence_number",
                "signer",
                "signer_ocsp",
                "tsl_signer_ca"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ],
          "description": "The verified TSL the CAs come from, its signer and the TSL signer CA; null with the embedded roots alone"
        }
      },
      "required": [
        "source",
        "fetched_at",
        "tsl_next_update",
        "roots",
        "intermediates",
        "tsl_warnings",
        "tsl",
        "note"
      ],
      "additionalProperties": false
    }
  }
}
