{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "probe",
  "description": "Which TI services of an environment answered; exit 0 when none failed, 1 otherwise.",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1,
      "description": "The JSON contract version; fields are only added within it."
    },
    "environment": {
      "enum": [
        "prod",
        "ref",
        "test",
        "dev"
      ]
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "counts": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "integer"
        },
        "warn": {
          "type": "integer"
        },
        "fail": {
          "type": "integer"
        }
      },
      "required": [
        "ok",
        "warn",
        "fail"
      ],
      "additionalProperties": false
    },
    "access_paths": {
      "type": "array",
      "description": "Per access path with endpoints, whether any of them answered.",
      "items": {
        "type": "object",
        "properties": {
          "access": {
            "enum": [
              "ti-vpn",
              "internet"
            ]
          },
          "available": {
            "type": "boolean",
            "description": "False when every endpoint of the path failed: the path is down (for ti-vpn, no TI VPN), not the services."
          },
          "probes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "access",
          "available",
          "probes"
        ],
        "additionalProperties": false
      }
    },
    "probes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Lowercase kebab-case: <service>-<n> for numbered instances (epa-1), the service for a singleton (catalog), idpd-ti / idpd-internet for the IDP."
          },
          "access": {
            "enum": [
              "ti-vpn",
              "internet"
            ],
            "description": "How the endpoint is reached: ti-vpn only through a Konnektor's or TI-Gateway's VPN, internet directly. The catalog's instances are internet."
          },
          "kind": {
            "enum": [
              "oidc",
              "zeta",
              "catalog",
              "erp",
              "epa",
              "directory",
              "http"
            ]
          },
          "url": {
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "source": {
            "enum": [
              "builtin",
              "catalog"
            ],
            "description": "builtin, or an instance the service-discovery catalog lists."
          },
          "status": {
            "enum": [
              "ok",
              "warn",
              "fail"
            ],
            "description": "ok: the expected answer; warn: an answer, not the expected one; fail: no answer."
          },
          "detail": {
            "type": "string"
          },
          "http_status": {
            "type": [
              "integer",
              "null"
            ]
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "name",
          "access",
          "kind",
          "url",
          "host",
          "source",
          "status",
          "detail",
          "http_status",
          "duration_ms"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "environment",
    "duration_ms",
    "counts",
    "access_paths",
    "probes"
  ],
  "additionalProperties": false
}
