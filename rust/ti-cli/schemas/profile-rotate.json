{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "profile rotate",
  "description": "The new current kid, and the kids no live record used any more (STORE-043, STORE-044).",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1,
      "description": "The JSON contract version; fields are only added within it."
    },
    "profile": {
      "type": "string"
    },
    "current_kid": {
      "type": "string"
    },
    "removed_kids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "kids": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schema",
    "profile",
    "current_kid",
    "removed_kids",
    "kids"
  ],
  "additionalProperties": false
}
