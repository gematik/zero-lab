{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "store cleanup",
  "description": "Expired records removed per database (STORE-125).",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1,
      "description": "The JSON contract version; fields are only added within it."
    },
    "profile": {
      "type": "string"
    },
    "databases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "database": {
            "enum": [
              "state",
              "cache"
            ]
          },
          "path": {
            "type": "string"
          },
          "removed": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "database",
          "path",
          "removed"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "profile",
    "databases"
  ],
  "additionalProperties": false
}
