        "P12-001",
        "P12-002",
        "P12-010",
        "P12-012",
        "P12-030",
        "P12-031",
        "P12-040",
        "P12-041",
        "P12-045"
      ],
      "profile": "modern",
      "openssl": [],
      "key": "rsa",
      "chain": true,
      "password": "test",
      "encodings": [
        "der",
        "ber"
      ],
      "expect": {
        "code": "ok",
        "certificates": [
          "leaf",
          "ca"
        ],
        "keys": [
          "leaf"
        ],
        "pairs": 1,
        "mac": "sha256"
      }
    },
